---
import Icon, { type IconName } from './Icon.astro';

const pillars: {
	title: string;
	icon: IconName;
	tone: 'human' | 'success' | 'digital';
	text: string;
	href: string;
	cta: string;
}[] = [
	{
		title: 'Pesquisador',
		icon: 'book-open',
		tone: 'human',
		text: 'Sou mestrando em Ciência da Computação e pesquiso inteligência artificial, ciência de dados e blockchain.',
		href: '/blog/',
		cta: 'Ler o blog',
	},
	{
		title: 'Educador',
		icon: 'university',
		tone: 'success',
		text: 'Sou professor de computação no ensino superior e atuo na formação docente e na coordenação de projetos de tecnologia educacional.',
		href: '/work/',
		cta: 'Ver os trabalhos',
	},
	{
		title: 'Desenvolvedor',
		icon: 'square-terminal',
		tone: 'digital',
		text: 'Desenvolvo software para educação e pesquisa, de ferramentas de aprendizagem a protótipos de IA.',
		href: '/dev/',
		cta: 'Ver os projetos',
	},
];
---

<section class="mp-grid" aria-label="Três dimensões do trabalho" data-gap="6">
	{
		pillars.map(({ title, icon, tone, text, href, cta }) => (
			<article class="mp-card" data-tone={tone === 'digital' ? 'digital' : undefined}>
				<Icon icon={icon} size="lg" tone={tone} />
				<h2 class="mp-card__title">{title}</h2>
				<p class="mp-card__body">{text}</p>
				<div class="mp-card__footer">
					<a class="mp-link" data-variant="standalone" href={href}>{cta}</a>
				</div>
			</article>
		))
	}
</section>
