---
import Icon, { type IconName } from './Icon.astro';

const pillars: {
	title: string;
	icon: IconName;
	tone: 'human' | 'success' | 'digital';
	text: string;
	href: string;
	cta: string;
}[] = [
	{
		title: 'Pesquisador',
		icon: 'book-open',
		tone: 'human',
		text: 'Investigo como tecnologias emergentes, IA, blockchain e sistemas multi-agentes, entram na educação sem desumanizar o processo. Mestrado em Computação na UFRJ, com passagens por Stanford (Educação Inovadora), FDC (Transformação Digital), FGV (Ciência de Dados) e outras instituições.',
		href: '/blog/',
		cta: 'Ler o blog',
	},
	{
		title: 'Educador',
		icon: 'university',
		tone: 'success',
		text: 'Trabalho com formação de educadores e coordenação de programas de tecnologia educacional em uma rede nacional. Da sala de aula aos espaços maker, meu foco é criar condições para que as pessoas aprendam fazendo.',
		href: '/work/',
		cta: 'Ver os trabalhos',
	},
	{
		title: 'Desenvolvedor',
		icon: 'square-terminal',
		tone: 'digital',
		text: 'Escrevo código, construo modelos e desenho arquiteturas técnicas e organizacionais. O catálogo reúne ferramentas online, pesquisas e protótipos, com o estágio de cada projeto à vista.',
		href: '/dev/',
		cta: 'Ver os projetos',
	},
];
---

<section class="mp-grid" aria-label="Três dimensões do trabalho" data-gap="6">
	{
		pillars.map(({ title, icon, tone, text, href, cta }) => (
			<article class="mp-card" data-tone={tone === 'digital' ? 'digital' : undefined}>
				<Icon icon={icon} size="lg" tone={tone} />
				<h2 class="mp-card__title">{title}</h2>
				<p class="mp-card__body">{text}</p>
				<div class="mp-card__footer">
					<a class="mp-link" data-variant="standalone" href={href}>{cta}</a>
				</div>
			</article>
		))
	}
</section>
