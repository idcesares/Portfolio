---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
---

<header class="mp-stack page-hero" data-gap="4" data-hero-align={align}>
	<h1 class="type-display">{title}</h1>
	{tagline && <p class="mp-text type-body-lg" data-tone="muted" data-measure>{tagline}</p>}
	<slot />
</header>

<style>
	.page-hero h1 {
		max-width: 22ch;
		text-wrap: balance;
	}

	.page-hero[data-hero-align='center'] {
		align-items: center;
		text-align: center;
	}
</style>
