---
import Icon from './Icon.astro';
---

<!-- Site search as a Membrane dialog: native <dialog> gives focus trapping,
     Escape and the backdrop; membrane.js covers invoker commands and
     closedby="any" where the browser lacks them. -->
<dialog class="mp-dialog search-dialog" id="search-dialog" aria-labelledby="search-dialog-title" closedby="any">
	<div class="mp-dialog__header">
		<h2 class="mp-dialog__title" id="search-dialog-title">Busca</h2>
		<button
			class="mp-button"
			type="button"
			data-variant="ghost"
			data-size="sm"
			data-icon-only
			aria-label="Fechar busca"
			commandfor="search-dialog"
			command="close"
		>
			<Icon icon="x" />
		</button>
	</div>
	<div class="mp-dialog__body mp-stack" data-gap="4">
		<div class="mp-field">
			<label class="mp-field__label mp-visually-hidden" for="search-input">Buscar em posts e projetos</label>
			<input
				class="mp-input"
				type="search"
				id="search-input"
				placeholder="Pesquise posts e projetos…"
				autocomplete="off"
				autofocus
				aria-describedby="search-status"
				aria-controls="search-results"
			/>
		</div>
		<p id="search-status" class="mp-text search-status" data-tone="subtle" aria-live="polite"></p>
		<ul id="search-results" class="search-results" aria-label="Resultados da busca" hidden></ul>
	</div>
</dialog>

<style>
	.search-dialog {
		--mp-dialog-width: var(--container-sm);
		/* Open near the top, where the eye is after pressing the search button. */
		margin-block-start: min(12dvh, var(--space-24));
	}

	.search-status:empty {
		display: none;
	}

	.search-results {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.search-results :global(.search-result-item) {
		display: grid;
		gap: var(--space-1);
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		color: inherit;
		text-decoration: none;
		transition: background-color var(--transition-fast);
	}

	@media (hover: hover) {
		.search-results :global(.search-result-item:hover) {
			background-color: var(--color-bg-hover);
		}
	}

	.search-results :global(.search-result-item:focus-visible) {
		outline: var(--focus-ring);
		outline-offset: calc(-1 * var(--focus-ring-offset));
	}

	.search-results :global(.search-result-title) {
		color: var(--color-text-primary);
		font-weight: var(--weight-semibold);
	}

	.search-results :global(.search-result-description) {
		color: var(--color-text-secondary);
		font-size: var(--text-small);
		line-height: var(--leading-small);
	}

	.search-results :global(mark) {
		padding-inline: 0.15em;
		border-radius: var(--radius-sm);
		background-color: var(--color-digital-bg);
		color: var(--color-digital-text);
	}
</style>

<script>
	import type { SearchItem } from '../utils/searchData';

	type FuseInstance = import('fuse.js').default<SearchItem>;
	type FuseResult = import('fuse.js').FuseResult<SearchItem>;
	type FuseResultMatch = import('fuse.js').FuseResultMatch;

	const TYPE_LABELS: Record<SearchItem['type'], { label: string; tone: 'human' | 'digital' | 'info' }> = {
		blog: { label: 'Blog', tone: 'human' },
		work: { label: 'Trabalho', tone: 'info' },
		dev: { label: 'Projeto', tone: 'digital' },
	};

	const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
	const input = document.getElementById('search-input') as HTMLInputElement;
	const results = document.getElementById('search-results') as HTMLUListElement;
	const status = document.getElementById('search-status') as HTMLElement;

	let fuse: FuseInstance | null = null;
	let loading: Promise<void> | null = null;

	async function ensureLoaded() {
		if (fuse) return;
		loading ??= (async () => {
			try {
				const [{ default: Fuse }, response] = await Promise.all([import('fuse.js'), fetch('/search-data.json')]);
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				const data = await response.json();
				const items: SearchItem[] = Array.isArray(data) ? data : data.data ?? [];
				fuse = new Fuse(items, {
					keys: [
						{ name: 'title', weight: 0.4 },
						{ name: 'description', weight: 0.3 },
						{ name: 'content', weight: 0.2 },
						{ name: 'tags', weight: 0.1 },
					],
					threshold: 0.3,
					includeMatches: true,
					minMatchCharLength: 2,
					ignoreLocation: true,
				});
			} catch (error) {
				console.error('Failed to load search data:', error);
				fuse = null;
			} finally {
				loading = null;
			}
		})();
		await loading;
	}

	/** Text only: editorial markup in titles is shown, never parsed. */
	function highlight(text: string, matches?: readonly FuseResultMatch[]) {
		const fragment = document.createDocumentFragment();
		let cursor = 0;
		const indices = [...(matches?.[0]?.indices ?? [])].sort((a, b) => a[0] - b[0]);
		for (const [start, end] of indices) {
			if (start < cursor) continue;
			fragment.append(text.slice(cursor, start));
			const mark = document.createElement('mark');
			mark.textContent = text.slice(start, end + 1);
			fragment.append(mark);
			cursor = end + 1;
		}
		fragment.append(text.slice(cursor));
		return fragment;
	}

	function truncate(text: string, max: number) {
		if (text.length <= max) return text;
		const cut = text.slice(0, max);
		const space = cut.lastIndexOf(' ');
		return `${space > max * 0.8 ? cut.slice(0, space) : cut}…`;
	}

	function showStatus(message: string) {
		status.textContent = message;
	}

	function render(found: FuseResult[]) {
		if (found.length === 0) {
			results.hidden = true;
			results.replaceChildren();
			showStatus('Nada encontrado. Tente outra palavra.');
			return;
		}
		const items = found.map(({ item, matches }) => {
			const li = document.createElement('li');
			const link = document.createElement('a');
			link.href = item.url;
			link.className = 'search-result-item';
			const type = document.createElement('span');
			const { label, tone } = TYPE_LABELS[item.type];
			type.className = 'mp-badge';
			type.dataset.tone = tone;
			type.textContent = label;
			const title = document.createElement('span');
			title.className = 'search-result-title';
			title.append(highlight(item.title, matches?.filter((m) => m.key === 'title')));
			const description = document.createElement('span');
			description.className = 'search-result-description';
			description.textContent = truncate(item.description, 120);
			link.append(type, title, description);
			li.append(link);
			return li;
		});
		results.replaceChildren(...items);
		results.hidden = false;
		showStatus(`${found.length} ${found.length === 1 ? 'resultado' : 'resultados'}`);
	}

	async function search(query: string) {
		if (query.trim().length < 2) {
			results.hidden = true;
			showStatus('');
			return;
		}
		if (!fuse) showStatus('Carregando a busca…');
		await ensureLoaded();
		if (!fuse) {
			showStatus('A busca está indisponível agora.');
			return;
		}
		// The input may have changed while the index loaded.
		if (input.value !== query) return;
		render(fuse.search(query).slice(0, 8));
	}

	input.addEventListener('input', () => void search(input.value));

	// Warm the index as soon as someone reaches for search. `autofocus` on the
	// field makes showModal() focus it instead of the close button.
	document.addEventListener('click', (event) => {
		if ((event.target as Element | null)?.closest('[commandfor="search-dialog"][command="show-modal"]')) {
			void ensureLoaded();
		}
	});

	// "/" opens search from anywhere outside a text field.
	document.addEventListener('keydown', (event) => {
		if (event.key !== '/' || dialog.open || event.metaKey || event.ctrlKey || event.altKey) return;
		const target = event.target as HTMLElement;
		if (target.closest('input, textarea, select, [contenteditable]')) return;
		event.preventDefault();
		void ensureLoaded();
		dialog.showModal();
	});
</script>
