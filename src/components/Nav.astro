---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import SearchBox from './SearchBox.astro';
import ThemeToggle from './ThemeToggle.astro';

const links: { label: string; href: string; prefetch?: 'load' | 'hover' | 'viewport' }[] = [
	{ label: 'Início', href: '/', prefetch: 'load' },
	{ label: 'Trabalhos', href: '/work/', prefetch: 'load' },
	{ label: 'Blog', href: '/blog/', prefetch: 'load' },
	{ label: 'Projetos', href: '/dev/' },
	{ label: 'Sobre', href: '/about/' },
	{ label: 'Contato', href: '/contact/' },
];

const isCurrent = (href: string) =>
	Astro.url.pathname === href || (href !== '/' && Astro.url.pathname.startsWith(href));
---

<!-- Membrane Navbar: sticky and translucent; below 48rem of its own width the
     links become a horizontally scrolling row, so there is no hidden menu. -->
<header class="mp-navbar">
	<div class="mp-navbar__inner">
		<!-- The dc monogram: both registers in one mark, the same as the favicon;
		     the compact wordmark signs the footer (DESIGN-SYSTEM.md §10.6). -->
		<a class="mp-navbar__brand" href="/" aria-label="D'Césares, página inicial">
			<BrandMark variant="monogram" />
		</a>
		<nav class="mp-navbar__nav" aria-label="Navegação principal">
			<ul class="mp-navbar__links">
				{
					links.map(({ label, href, prefetch }) => (
						<li>
							<a
								class="mp-navbar__link"
								href={href}
								aria-current={isCurrent(href) ? 'page' : undefined}
								data-astro-prefetch={prefetch}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="mp-navbar__actions">
			<button
				class="mp-button"
				type="button"
				data-variant="ghost"
				data-icon-only
				aria-label="Abrir busca"
				aria-haspopup="dialog"
				aria-keyshortcuts="/"
				commandfor="search-dialog"
				command="show-modal"
			>
				<Icon icon="search" />
			</button>
			<ThemeToggle />
		</div>
	</div>
</header>

<SearchBox />
