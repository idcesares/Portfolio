---
/**
 * Membrane Icon (.mp-icon): Lucide line icons, sized by --size-icon-* and
 * colored by tone (DESIGN-SYSTEM.md §7.3). Brand logos are no longer in
 * Lucide 1.x, so their outlines (from Lucide 0.x, ISC) live here.
 */
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import BookOpen from '@lucide/astro/icons/book-open';
import Code from '@lucide/astro/icons/code';
import ExternalLink from '@lucide/astro/icons/external-link';
import Globe from '@lucide/astro/icons/globe';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Mail from '@lucide/astro/icons/mail';
import Mic from '@lucide/astro/icons/mic';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Moon from '@lucide/astro/icons/moon';
import PencilLine from '@lucide/astro/icons/pencil-line';
import Rocket from '@lucide/astro/icons/rocket';
import Search from '@lucide/astro/icons/search';
import Send from '@lucide/astro/icons/send';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import SquareTerminal from '@lucide/astro/icons/square-terminal';
import Sun from '@lucide/astro/icons/sun';
import University from '@lucide/astro/icons/university';
import X from '@lucide/astro/icons/x';
import { Icon as LucideIcon, type LucideIconNode, type LucideProps } from '@lucide/astro';

const lucide = {
	'arrow-left': ArrowLeft,
	'arrow-right': ArrowRight,
	'arrow-up-right': ArrowUpRight,
	'book-open': BookOpen,
	code: Code,
	'external-link': ExternalLink,
	globe: Globe,
	lightbulb: Lightbulb,
	mail: Mail,
	mic: Mic,
	'message-circle': MessageCircle,
	moon: Moon,
	'pencil-line': PencilLine,
	rocket: Rocket,
	search: Search,
	send: Send,
	'sliders-horizontal': SlidersHorizontal,
	'square-terminal': SquareTerminal,
	sun: Sun,
	university: University,
	x: X,
} as const;

const brands = {
	github: [
		['path', { d: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4' }],
		['path', { d: 'M9 18c-4.51 2-5-2-7-2' }],
	],
	linkedin: [
		['path', { d: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z' }],
		['rect', { width: '4', height: '12', x: '2', y: '9' }],
		['circle', { cx: '4', cy: '4', r: '2' }],
	],
	twitter: [
		['path', { d: 'M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z' }],
	],
	youtube: [
		['path', { d: 'M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17' }],
		['path', { d: 'm10 15 5-3-5-3z' }],
	],
} satisfies Record<string, LucideIconNode[]>;

export type IconName = keyof typeof lucide | keyof typeof brands;

interface Props {
	icon: IconName;
	/** Token size: sm 20px, (default) 24px, lg 32px, xl 48px. */
	size?: 'sm' | 'lg' | 'xl';
	/** Register or status color; omit to inherit the text color. */
	tone?: 'human' | 'digital' | 'success' | 'warning' | 'error';
	/** Accessible name. Omit for decorative icons (aria-hidden). */
	label?: string;
	class?: string;
}

const { icon, size, tone, label, class: className } = Astro.props;
const Component = icon in lucide ? lucide[icon as keyof typeof lucide] : null;
const attrs: LucideProps = {
	class: ['mp-icon', className].filter(Boolean).join(' '),
	// Membrane sizes and strokes the icon from CSS; drop Lucide's 24px/2px defaults.
	size: '1em',
	'data-size': size,
	'data-tone': tone,
	...(label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const }),
};
---

{Component ? <Component {...attrs} /> : <LucideIcon iconNode={brands[icon as keyof typeof brands]} {...attrs} />}
