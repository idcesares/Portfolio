---
import type { CollectionEntry } from 'astro:content';
import ContentPreview from './ContentPreview.astro';
interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'default' | 'compact';
  eager?: boolean;
}
const { post, variant = 'default', eager = false } = Astro.props;
---

<ContentPreview entry={post} variant={variant} eager={eager} />
