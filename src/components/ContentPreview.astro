---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ContentDateMeta from './ContentDateMeta.astro';

interface Props {
	entry: CollectionEntry<'blog'> | CollectionEntry<'work'>;
	variant?: 'default' | 'compact';
	/** Load the image eagerly (first card above the fold). */
	eager?: boolean;
	/** Raise the image fetch priority (the likely LCP element). */
	priority?: boolean;
}
const { entry, variant = 'default', eager = false, priority = false } = Astro.props;
const { data, id, collection } = entry;
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

<li
	class="content-preview"
	data-variant={variant}
	data-filterable-item
	data-tags={data.tags.join(', ')}
	data-title={data.title}
	data-description={data.description}
	data-updated-date={data.updatedDate.toISOString()}
>
	<!-- Membrane clickable card: the title link stretches over the whole card. -->
	<article class="mp-card" data-tone={collection === 'work' ? 'digital' : undefined}>
		<div class="mp-card__media">
			{
				typeof data.img === 'string' ? (
					<img src={data.img} alt={data.img_alt || ''} width="600" height="338" loading={loading} fetchpriority={fetchpriority} decoding="async" />
				) : (
					<Image src={data.img} alt={data.img_alt || ''} width={600} height={338} quality={80} loading={loading} fetchpriority={fetchpriority} decoding="async" />
				)
			}
		</div>
		<ContentDateMeta class="mp-card__overline" publishDate={data.publishDate} updatedDate={data.updatedDate} />
		<h3 class="mp-card__title"><a class="mp-card__link" href={`/${collection}/${id}/`}>{data.title}</a></h3>
		<p class="mp-card__body">{data.description}</p>
		{
			data.tags.length > 0 && (
				<div class="mp-card__footer">
					{data.tags.slice(0, 2).map((tag) => (
						<span class="mp-tag">{tag}</span>
					))}
					{data.tags.length > 2 && <span class="mp-text type-small" data-tone="subtle">+{data.tags.length - 2}</span>}
				</div>
			)
		}
	</article>
</li>

<style>
	.content-preview {
		display: grid;
		min-width: 0;
	}

	.mp-card__title {
		overflow-wrap: anywhere;
	}

	/* Compact (and the list view): text first, a small square thumbnail aside. */
	@media (min-width: 35em) {
		:global(.card-list[data-view='list']) .content-preview .mp-card,
		.content-preview[data-variant='compact'] .mp-card {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 7rem;
			column-gap: var(--space-6);
			align-content: start;
		}

		:global(.card-list[data-view='list']) .content-preview .mp-card > :not(.mp-card__media),
		.content-preview[data-variant='compact'] .mp-card > :not(.mp-card__media) {
			grid-column: 1;
		}

		:global(.card-list[data-view='list']) .content-preview .mp-card__media,
		.content-preview[data-variant='compact'] .mp-card__media {
			grid-column: 2;
			grid-row: 1 / span 4;
			aspect-ratio: 1;
			margin: 0;
			border-radius: var(--radius-md);
		}
	}
</style>
