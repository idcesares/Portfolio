---
/**
 * A Membrane tag (.mp-tag) naming a topic or one of the three dimensions.
 * Tone is the register: human (terracotta), digital (teal), or neutral.
 * "learning" is the educator dimension, drawn with the sage success pair
 * through the tag's own knobs (the sanctioned per-instance override).
 */
interface Props {
	tone?: 'human' | 'digital' | 'learning';
	href?: string;
}

const { tone, href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class="mp-tag pill" href={href} data-tone={tone === 'learning' ? undefined : tone} data-learning={tone === 'learning' ? '' : undefined}>
	<slot />
</Tag>

<style>
	.pill[data-learning] {
		--mp-tag-bg: var(--color-success-bg);
		--mp-tag-fg: var(--color-success-text);
	}

	.pill :global(.mp-icon) {
		--mp-icon-size: 1.25em;
	}
</style>
