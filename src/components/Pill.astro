---
import { toneColors, type Tone } from './toneColors';

interface Props {
	color?: Tone;
}

const { color = 'teal' } = Astro.props;

const c = toneColors[color];
---

<div
	class="pill"
	style={`--pill-bg: ${c.bg}; --pill-border: ${c.border}; --pill-text: ${c.text};`}
>
	<slot />
</div>

<style>
	.pill {
		display: flex;
		padding: var(--space-2) var(--space-4);
		gap: var(--space-2);
		color: var(--pill-text);
		border: 1px solid var(--pill-border);
		background-color: var(--pill-bg);
		border-radius: var(--radius-full);
		font-size: var(--text-small);
		line-height: var(--leading-small);
		white-space: nowrap;
		align-items: center;
	}
</style>
