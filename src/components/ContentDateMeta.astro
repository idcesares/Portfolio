---
interface Props {
	publishDate: Date;
	updatedDate: Date;
	class?: string;
}

const { publishDate, updatedDate, class: className } = Astro.props;
const publish = new Date(publishDate);
const updated = new Date(updatedDate);
const isUpdated = updated.getTime() > publish.getTime();
const displayDate = isUpdated ? updated : publish;
const label = isUpdated ? 'Atualizado em' : 'Publicado em';
const formattedDate = displayDate.toLocaleDateString('pt-BR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<p class:list={['content-date', className]} data-updated={isUpdated ? 'true' : 'false'}>
	{label} <time datetime={displayDate.toISOString()}>{formattedDate}</time>
</p>
