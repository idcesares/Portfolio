---
---

<cookie-consent>
	<div class="cc-card" role="region" aria-label="Preferências de cookies" hidden>
		<p class="cc-text">
			Uso <strong>Google Analytics</strong> pra entender quais posts e projetos rendem mais leitura por aqui. Nenhum dado vai pra anúncio nem é repassado a terceiros.
		</p>
		<div class="cc-actions">
			<button type="button" class="cc-btn cc-btn-ghost" data-cc="reject">Recusar</button>
			<button type="button" class="cc-btn cc-btn-solid" data-cc="accept">Aceitar</button>
		</div>
	</div>
</cookie-consent>

<style>
	.cc-card {
		position: fixed;
		left: var(--space-4);
		right: var(--space-4);
		bottom: var(--space-4);
		z-index: var(--z-toast);
		max-width: 26rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-5) var(--space-6);
		border-radius: var(--radius-xl);
		border: 1px solid var(--color-border-default);
		background: color-mix(in oklab, var(--color-bg-secondary) 92%, transparent);
		backdrop-filter: blur(var(--blur-backdrop));
		-webkit-backdrop-filter: blur(var(--blur-backdrop));
		box-shadow: var(--shadow-lg);
		opacity: 0;
		transform: translateY(calc(var(--space-4) + 8px));
		transition: opacity var(--duration-slow) var(--ease-out),
			transform var(--duration-slow) var(--ease-out);
	}

	.cc-card.cc-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.cc-card.cc-leaving {
		opacity: 0;
		transform: translateY(calc(var(--space-4) + 8px));
	}

	.cc-text {
		font-size: var(--text-small);
		line-height: var(--leading-body);
		color: var(--color-text-secondary);
		margin: 0;
	}

	.cc-text strong {
		color: var(--color-text-primary);
		font-weight: var(--weight-medium);
	}

	.cc-actions {
		display: flex;
		gap: var(--space-3);
		justify-content: flex-end;
	}

	.cc-btn {
		min-height: 44px;
		padding: var(--space-2) var(--space-6);
		border-radius: var(--radius-full);
		font-size: var(--text-small);
		font-weight: var(--weight-medium);
		cursor: pointer;
		transition: transform var(--transition-default), background-color var(--transition-default);
	}

	.cc-btn:active {
		transform: scale(0.97);
	}

	.cc-btn-ghost {
		border: 1px solid var(--color-border-default);
		background: transparent;
		color: var(--color-text-secondary);
	}

	.cc-btn-ghost:hover {
		background: var(--color-bg-tertiary);
		color: var(--color-text-primary);
	}

	.cc-btn-solid {
		border: 1px solid var(--color-terracotta-dark);
		background: var(--color-terracotta);
		color: var(--color-text-on-accent);
		box-shadow: var(--shadow-sm);
	}

	.cc-btn-solid:hover {
		background: var(--color-terracotta-light);
	}

	@media (min-width: 50em) {
		.cc-card {
			left: auto;
			margin-inline: 0;
		}
	}
</style>

<script>
	const GA_ID = 'G-0XZV7NBH4E';
	const STORAGE_KEY = 'cookie-consent';

	class CookieConsent extends HTMLElement {
		constructor() {
			super();

			const card = this.querySelector<HTMLElement>('.cc-card')!;
			const consent = localStorage.getItem(STORAGE_KEY);

			if (consent === 'granted') {
				this.loadAnalytics();
				return;
			}
			if (consent === 'denied') {
				return;
			}

			// Let the page settle before asking — a banner that appears instantly
			// competes with content the visitor came here to read.
			card.removeAttribute('hidden');
			window.setTimeout(() => card.classList.add('cc-visible'), 1200);

			this.querySelector('[data-cc="accept"]')?.addEventListener('click', () => {
				localStorage.setItem(STORAGE_KEY, 'granted');
				this.loadAnalytics();
				this.dismiss(card);
			});

			this.querySelector('[data-cc="reject"]')?.addEventListener('click', () => {
				localStorage.setItem(STORAGE_KEY, 'denied');
				this.dismiss(card);
			});
		}

		dismiss(card: HTMLElement) {
			card.classList.remove('cc-visible');
			card.classList.add('cc-leaving');
			window.setTimeout(() => card.setAttribute('hidden', ''), 400);
		}

		loadAnalytics() {
			if ((window as any).__gaLoaded) return;
			(window as any).__gaLoaded = true;

			(window as any).dataLayer = (window as any).dataLayer || [];
			function gtag(...args: unknown[]) {
				(window as any).dataLayer.push(args);
			}
			(window as any).gtag = gtag;
			gtag('js', new Date());
			gtag('config', GA_ID);

			const script = document.createElement('script');
			script.type = 'text/partytown';
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
			document.head.appendChild(script);
		}
	}

	customElements.define('cookie-consent', CookieConsent);
</script>
