---
---

<cookie-consent>
	<!-- A floating Membrane card: enters slowly, leaves quickly (spec §8.4). -->
	<div class="mp-card cc-card" role="region" aria-label="Preferências de cookies" hidden>
		<p class="mp-card__body type-small">
			Com sua permissão, uso <strong>Google Analytics</strong> pra entender quais posts e projetos rendem mais leitura por aqui. Os dados de uso são processados pelo Google. Você pode rever sua escolha nas preferências de cookies no rodapé.
		</p>
		<div class="mp-cluster" data-justify="end" data-gap="2">
			<button type="button" class="mp-button" data-variant="ghost" data-size="sm" data-cc="reject">Recusar</button>
			<button type="button" class="mp-button" data-size="sm" data-cc="accept">Aceitar</button>
		</div>
	</div>
</cookie-consent>

<style>
	.cc-card {
		--mp-card-padding: var(--space-5);
		--mp-card-bg: var(--color-bg-elevated);
		--mp-card-shadow: var(--elevation-overlay);

		position: fixed;
		inset-inline: var(--space-4);
		inset-block-end: var(--space-4);
		z-index: var(--z-toast);
		max-width: 26rem;
		margin-inline: auto;
		gap: var(--space-4);
		opacity: 0;
		translate: 0 var(--space-2);
		transition:
			opacity var(--transition-exit),
			translate var(--transition-exit);
	}

	.cc-card[data-visible] {
		opacity: 1;
		translate: 0 0;
		transition:
			opacity var(--transition-enter),
			translate var(--transition-enter);
	}

	.cc-card strong {
		color: var(--color-text-primary);
		font-weight: var(--weight-semibold);
	}

	@media (min-width: 50em) {
		.cc-card {
			inset-inline: auto var(--space-6);
			inset-block-end: var(--space-6);
		}
	}

	@media print {
		.cc-card {
			display: none;
		}
	}
</style>

<script>
	const GA_ID = 'G-0XZV7NBH4E';
	const STORAGE_KEY = 'cookie-consent';
	const FALLBACK_COOKIE = 'portfolio-consent';
	const DENIAL_MARKER = `[portfolio-consent-denied:${window.location.origin}]`;
	const readFallbackCookie = () => {
		try {
			return document.cookie.split('; ').find((cookie) => cookie.startsWith(`${FALLBACK_COOKIE}=`))?.split('=')[1] ?? null;
		} catch { return null; }
	};

	class CookieConsent extends HTMLElement {
		private dismissTimer: number | undefined;
		constructor() {
			super();

			const card = this.querySelector<HTMLElement>('.cc-card')!;
			let consent: string | null = null;
			try { consent = localStorage.getItem(STORAGE_KEY); } catch { /* Ask on this visit. */ }
			if (readFallbackCookie() === 'denied') consent = 'denied';
			if (window.name.endsWith(DENIAL_MARKER)) consent = 'denied';
			const saveConsent = (value: string) => {
				let saved = false;
				try {
					localStorage.setItem(STORAGE_KEY, value);
					saved = true;
					try { document.cookie = `${FALLBACK_COOKIE}=; Max-Age=0; Path=/; SameSite=Lax`; } catch { /* Optional fallback. */ }
				} catch {
					// Quota/read-only storage can retain an old grant. Prefer the
					// denial via an essential first-party session cookie.
					try {
						document.cookie = value === 'denied'
							? `${FALLBACK_COOKIE}=denied; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`
							: `${FALLBACK_COOKIE}=; Max-Age=0; Path=/; SameSite=Lax`;
						saved = value === 'denied' && readFallbackCookie() === 'denied';
					} catch { /* Preserve denial within this tab below. */ }
				}
				if (window.name.endsWith(DENIAL_MARKER)) window.name = window.name.slice(0, -DENIAL_MARKER.length);
				// If all persistent storage is blocked, window.name survives a
				// same-tab reload. Scope the non-sensitive denial to this origin
				// and preserve any pre-existing window name.
				if (value === 'denied' && !saved) window.name += DENIAL_MARKER;
			};
			const showCard = () => {
				window.clearTimeout(this.dismissTimer);
				card.hidden = false;
				requestAnimationFrame(() => card.setAttribute('data-visible', ''));
			};
			document.querySelectorAll<HTMLButtonElement>('[data-cookie-preferences]').forEach((button) => {
				button.hidden = false;
				button.addEventListener('click', () => {
					showCard();
					card.querySelector<HTMLButtonElement>('[data-cc="reject"]')?.focus();
				});
			});
			this.querySelector('[data-cc="accept"]')?.addEventListener('click', () => {
				saveConsent('granted');
				this.loadAnalytics();
				this.dismiss(card);
			});
			this.querySelector('[data-cc="reject"]')?.addEventListener('click', () => {
				saveConsent('denied');
				this.dismiss(card);
				// End the current worker and prevent Analytics on the next page.
				if ((window as any).__gaLoaded) window.location.reload();
			});

			if (consent === 'granted') {
				this.loadAnalytics();
				return;
			}
			if (consent === 'denied') {
				return;
			}

			// Let the page settle before asking — a banner that appears instantly
			// competes with content the visitor came here to read.
			card.removeAttribute('hidden');
			window.setTimeout(() => card.setAttribute('data-visible', ''), 1200);

		}

		dismiss(card: HTMLElement) {
			card.removeAttribute('data-visible');
			window.clearTimeout(this.dismissTimer);
			// Hide once the exit transition (0ms under reduced motion) has run.
			const exit = parseFloat(getComputedStyle(card).transitionDuration) * 1000 || 0;
			this.dismissTimer = window.setTimeout(() => card.setAttribute('hidden', ''), exit);
		}

		loadAnalytics() {
			if ((window as any).__gaLoaded) return;
			(window as any).__gaLoaded = true;

			(window as any).dataLayer = (window as any).dataLayer || [];
			function gtag(...args: unknown[]) {
				(window as any).dataLayer.push(args);
			}
			(window as any).gtag = gtag;
			gtag('js', new Date());
			gtag('config', GA_ID);

			const script = document.createElement('script');
			script.type = 'text/partytown';
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
			document.head.appendChild(script);
		}
	}

	customElements.define('cookie-consent', CookieConsent);
</script>
