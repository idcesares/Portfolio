---
import BrandMark from './BrandMark.astro';
import Icon, { type IconName } from './Icon.astro';

const currentYear = new Date().getFullYear();

const socialLinks: { label: string; href: string; icon: IconName }[] = [
	{ label: 'LinkedIn', href: 'https://linkedin.com/in/isaacdcesares', icon: 'linkedin' },
	{ label: 'Twitter', href: 'https://twitter.com/idcesares', icon: 'twitter' },
	{ label: 'GitHub', href: 'https://github.com/idcesares', icon: 'github' },
	{ label: 'YouTube', href: 'https://www.youtube.com/@idcesares/', icon: 'youtube' },
];
---

<footer class="site-footer">
	<div class="mp-container mp-stack" data-gap="8">
		<div class="mp-cluster" data-justify="between" data-gap="6">
			<a class="site-footer__brand" href="/" aria-label="D'Césares, página inicial">
				<BrandMark variant="compact" />
			</a>
			<ul class="mp-cluster site-footer__social" data-gap="1" aria-label="Redes sociais">
				{
					socialLinks.map(({ href, icon, label }) => (
						<li>
							<a
								class="mp-button"
								data-variant="ghost"
								data-icon-only
								href={href}
								target="_blank"
								rel="noopener"
								aria-label={label}
							>
								<Icon icon={icon} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<hr class="mp-divider" data-variant="full" />
		<div class="mp-cluster type-small site-footer__meta" data-justify="between" data-gap="4">
			<p>
				&copy; {currentYear} Isaac D'Césares. Feito em <a class="mp-link" data-variant="quiet" href="https://astro.build/">Astro</a>
				com <a class="mp-link" data-variant="quiet" href="https://membrane-palette.dcesares.dev">The Membrane Palette</a>.
			</p>
			<ul class="mp-cluster site-footer__links" data-gap="4">
				<li><a class="mp-link" data-variant="quiet" href="/tech-signal/">Tech Signal</a></li>
				<li><a class="mp-link" data-variant="quiet" href="/deals/">Indico e uso</a></li>
				<li>
					<button type="button" class="mp-button" data-variant="ghost" data-size="sm" data-cookie-preferences hidden>
						Preferências de cookies
					</button>
				</li>
			</ul>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-24);
		padding-block: var(--space-12);
		border-block-start: var(--border-default);
		background-color: var(--color-bg-secondary);
		color: var(--color-text-secondary);
	}

	.site-footer__brand {
		color: var(--color-text-primary);
		border-radius: var(--radius-sm);
	}

	.site-footer__social,
	.site-footer__links {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__social :global(.mp-button) {
		--mp-button-fg: var(--color-text-secondary);
		--mp-button-fg-hover: var(--color-text-primary);
	}
</style>
