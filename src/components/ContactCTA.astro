---
import Icon from './Icon.astro';
---

<!-- The signature call to action, on the membrane gradient wash. -->
<aside class="mp-section contact-cta" aria-labelledby="contact-cta-title">
	<div class="mp-container mp-cluster" data-justify="between" data-gap="8">
		<h2 class="type-display" id="contact-cta-title">Vamos cocriar soluções humanas e tecnológicas?</h2>
		<a class="mp-button" data-size="lg" href="/contact/">
			Abrir contato
			<Icon icon="send" />
		</a>
	</div>
</aside>

<style>
	.contact-cta {
		margin-block-start: var(--space-24);
		border-block: var(--border-default);
		background:
			var(--gradient-warmth),
			var(--color-bg-secondary);
	}

	.contact-cta h2 {
		max-width: 16ch;
	}
</style>
