---
/** Card grid on the Membrane layout primitive (.mp-grid, auto-fit columns). */
interface Props {
	/** wide: two or three roomy columns; compact: denser columns; list: one column. */
	variant?: 'wide' | 'compact' | 'list';
}

const { variant = 'wide' } = Astro.props;
---

{
	variant === 'list' ? (
		<ul class="mp-stack card-list" data-view="list" data-gap="4"><slot /></ul>
	) : (
		<ul class="mp-grid card-list" data-view={variant} data-min={variant === 'wide' ? 'lg' : undefined} data-gap="8"><slot /></ul>
	)
}

<style>
	.card-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* List view (FilterBar): one column of compact cards. */
	.card-list[data-view='list'] {
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-4);
	}
</style>
