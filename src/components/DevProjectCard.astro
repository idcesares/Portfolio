---
import type { DevProject } from '../data/dev-projects';
import { categoryLabels, statusLabels, statusTones } from '../data/dev-projects';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	project: DevProject;
	variant?: 'featured' | 'default';
}

const { project, variant = 'default' } = Astro.props;
const featured = variant === 'featured';

const description = featured && project.longDescription ? project.longDescription : project.description;
const maxTags = featured ? project.techStack.length : 4;
const visibleTech = project.techStack.slice(0, maxTags);
const remainingCount = project.techStack.length - maxTags;

const placeholderIcons: Record<DevProject['category'], IconName> = {
	product: 'rocket',
	system: 'code',
	research: 'book-open',
	education: 'pencil-line',
	experiment: 'square-terminal',
};
---

<!-- Membrane card. Products and systems are the digital register (teal accent);
     research and education stay in the human register (terracotta). -->
<article
	id={`project-${project.id}`}
	class="mp-card dev-card"
	data-variant={featured ? 'featured' : undefined}
	data-tone={project.category === 'research' || project.category === 'education' ? undefined : 'digital'}
	data-category={project.category}
	data-animate
>
	<div class="mp-card__media">
		{
			project.img ? (
				<img src={project.img} alt={project.imgAlt || ''} width="800" height="450" loading="lazy" decoding="async" />
			) : (
				<div class="dev-card__placeholder" aria-hidden="true">
					<Icon icon={placeholderIcons[project.category]} size="xl" />
				</div>
			)
		}
	</div>

	<div class="dev-card__content mp-stack" data-gap="3">
		<div class="mp-cluster" data-justify="between" data-gap="2">
			<p class="mp-card__overline">{categoryLabels[project.category]} · {project.year}</p>
			<span class="mp-badge" data-variant="dot" data-tone={statusTones[project.status]}>{statusLabels[project.status]}</span>
		</div>

		<h3 class="mp-card__title">{project.title}</h3>
		<p class="mp-card__body">{description}</p>

		<ul class="mp-cluster dev-card__tech" data-gap="2" aria-label="Tecnologias">
			{visibleTech.map((tech) => <li class="mp-tag">{tech.name}</li>)}
			{remainingCount > 0 && <li class="mp-tag" aria-label={`Mais ${remainingCount}`}>+{remainingCount}</li>}
		</ul>

		{
			project.availability && (
				<div class="mp-alert dev-card__availability">
					<Icon icon="square-terminal" class="mp-alert__icon" />
					<div class="mp-alert__content">
						<p>{project.availability}</p>
					</div>
				</div>
			)
		}

		<div class="mp-card__footer mp-cluster" data-gap="2">
			{
				project.demoUrl && (
					<a class="mp-button" data-size="sm" href={project.demoUrl} target="_blank" rel="noopener noreferrer">
						<Icon icon="globe" />
						{project.primaryActionLabel || 'Abrir projeto'}
						<Icon icon="external-link" />
					</a>
				)
			}
			{
				project.repoUrl && (
					<a class="mp-button" data-variant="ghost" data-size="sm" href={project.repoUrl} target="_blank" rel="noopener noreferrer">
						<Icon icon="github" />
						{project.repoActionLabel || 'Ver no GitHub'}
					</a>
				)
			}
		</div>
	</div>
</article>

<style>
	.dev-card {
		scroll-margin-top: var(--space-24);
		height: 100%;
	}

	.dev-card__content {
		flex: 1;
	}

	.dev-card__placeholder {
		display: grid;
		place-items: center;
		height: 100%;
		background: var(--gradient-membrane);
		color: var(--color-text-on-accent);
	}

	.dev-card__tech {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dev-card__availability {
		font-size: var(--text-small);
	}

	/* Featured: media beside the text on wide screens. */
	@media (min-width: 60em) {
		.dev-card[data-variant='featured'] {
			display: grid;
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			column-gap: var(--space-10);
			align-items: stretch;
		}

		.dev-card[data-variant='featured'] .mp-card__media {
			aspect-ratio: auto;
			min-height: 100%;
			margin: calc(-1 * var(--mp-card-padding)) 0 calc(-1 * var(--mp-card-padding)) calc(-1 * var(--mp-card-padding));
			border-radius: calc(var(--radius-lg) - var(--border-width-thin)) 0 0 calc(var(--radius-lg) - var(--border-width-thin));
		}

		.dev-card[data-variant='featured'] .mp-card__title {
			font-size: var(--text-h2);
		}
	}
</style>
