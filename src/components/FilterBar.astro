---
import Icon from './Icon.astro';

interface Props {
	variant?: 'blog' | 'work';
	tags: string[];
}

const { variant = 'blog', tags } = Astro.props;
const noun = variant === 'blog' ? 'posts' : 'projetos';

const sortOptions = [
	{ value: 'newest', label: 'Mais recentes' },
	{ value: 'oldest', label: 'Mais antigos' },
	{ value: 'alphabetical', label: 'Alfabética (A–Z)' },
];

const views = [
	{ value: 'wide', label: 'Cards grandes', d: 'M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z' },
	{ value: 'compact', label: 'Cards compactos', d: 'M3 3h5v5H3zM10 3h5v5h-5zM17 3h4v5h-4zM3 10h5v5H3zM10 10h5v5h-5zM17 10h4v5h-4zM3 17h5v4H3zM10 17h5v4h-5zM17 17h4v4h-4z' },
	{ value: 'list', label: 'Lista', d: 'M3 5h18M3 12h18M3 19h18' },
];

// The most frequent tags (the page passes them sorted by frequency).
const topTags = tags.slice(0, 8);
---

<section class="mp-card filter-bar" data-variant="flat" aria-label={`Filtrar ${noun}`} data-noun={noun}>
	<div class="mp-cluster" data-gap="3">
		<div class="mp-field filter-bar__search">
			<label class="mp-field__label mp-visually-hidden" for="local-search">{variant === 'blog' ? 'Buscar posts' : 'Buscar projetos'}</label>
			<input class="mp-input" type="search" id="local-search" placeholder={variant === 'blog' ? 'Buscar posts…' : 'Buscar projetos…'} autocomplete="off" />
		</div>
		<div class="mp-field">
			<label class="mp-field__label mp-visually-hidden" for="sort-select">Ordenar resultados</label>
			<select class="mp-input" id="sort-select">
				{sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
			</select>
		</div>
		<button
			class="mp-button"
			type="button"
			id="advanced-toggle"
			data-variant="ghost"
			data-icon-only
			aria-label="Filtros avançados"
			aria-controls="advanced-filters"
			aria-expanded="false"
		>
			<Icon icon="sliders-horizontal" />
		</button>
		<div class="mp-cluster filter-bar__views" role="group" aria-label="Visualização" data-gap="1">
			{
				views.map(({ value, label, d }) => (
					<button class="mp-button" type="button" data-variant="ghost" data-size="sm" data-icon-only data-view={value} aria-label={label} aria-pressed={value === 'wide' ? 'true' : 'false'}>
						<svg class="mp-icon" data-size="sm" viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg>
					</button>
				))
			}
		</div>
	</div>

	<div class="mp-cluster filter-bar__advanced" id="advanced-filters" data-align="baseline" data-gap="3" hidden>
		<div class="mp-field">
			<label class="mp-field__label" for="category-select">Categoria:</label>
			<select class="mp-input" id="category-select" data-size="sm">
				<option value="">Todas as categorias</option>
				{topTags.map((tag) => <option value={tag}>{tag}</option>)}
			</select>
		</div>
		<button class="mp-button" type="button" id="reset-filters" data-variant="ghost" data-size="sm">Limpar filtros</button>
	</div>

	<p class="mp-text type-small" data-tone="subtle" id="results-text" role="status" aria-atomic="true"></p>
</section>

<style>
	.filter-bar {
		--mp-card-padding: var(--space-4);
		gap: var(--space-3);
		margin-block-end: var(--space-8);
	}

	.filter-bar__search {
		flex: 1 1 16rem;
	}

	.filter-bar__views {
		margin-inline-start: auto;
	}

	.filter-bar__advanced {
		padding-block-start: var(--space-3);
		border-block-start: var(--border-default);
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>('.filter-bar');
	const grid = document.querySelector<HTMLElement>('.card-list');

	if (bar && grid) {
		const noun = bar.dataset.noun ?? 'itens';
		const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-filterable-item]'));
		const search = bar.querySelector<HTMLInputElement>('#local-search')!;
		const sort = bar.querySelector<HTMLSelectElement>('#sort-select')!;
		const category = bar.querySelector<HTMLSelectElement>('#category-select')!;
		const toggle = bar.querySelector<HTMLButtonElement>('#advanced-toggle')!;
		const advanced = bar.querySelector<HTMLElement>('#advanced-filters')!;
		const status = bar.querySelector<HTMLElement>('#results-text')!;
		const viewButtons = bar.querySelectorAll<HTMLButtonElement>('[data-view]');

		const normalize = (text: string) =>
			text.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

		const apply = () => {
			const query = normalize(search.value.trim());
			const tag = normalize(category.value);
			let visible = 0;
			for (const item of items) {
				const tags = normalize(item.dataset.tags ?? '');
				const haystack = `${normalize(item.dataset.title ?? '')} ${normalize(item.dataset.description ?? '')} ${tags}`;
				const show = (!tag || tags.includes(tag)) && (!query || haystack.includes(query));
				item.hidden = !show;
				if (show) visible += 1;
			}
			status.textContent = visible === items.length ? `${items.length} ${noun}` : `${visible} de ${items.length} ${noun}`;
		};

		const order = (mode: string) => {
			const date = (el: HTMLElement) => new Date(el.dataset.updatedDate ?? 0).getTime();
			const sorted = [...items].sort((a, b) => {
				if (mode === 'oldest') return date(a) - date(b);
				if (mode === 'alphabetical') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '', 'pt-BR');
				return date(b) - date(a);
			});
			grid.append(...sorted);
		};

		const setView = (view: string) => {
			grid.dataset.view = view;
			if (view === 'wide') grid.dataset.min = 'lg';
			else delete grid.dataset.min;
			viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
			try {
				localStorage.setItem('preferred-view', view);
			} catch {
				/* Remembering the view is optional. */
			}
		};

		search.addEventListener('input', apply);
		category.addEventListener('change', apply);
		sort.addEventListener('change', () => order(sort.value));
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-pressed', String(open));
			advanced.hidden = !open;
		});
		bar.querySelector('#reset-filters')!.addEventListener('click', () => {
			search.value = '';
			category.value = '';
			sort.value = 'newest';
			order('newest');
			apply();
			search.focus();
		});
		viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view ?? 'wide')));

		let saved: string | null = null;
		try {
			saved = localStorage.getItem('preferred-view');
		} catch {
			/* Storage blocked: default view. */
		}
		if (saved === 'compact' || saved === 'list') setView(saved);
		apply();
	}
</script>
