---
export const prerender = true;

import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" description="Erro 404: essa página não existe ou foi movida.">
	<main id="main-content" tabindex="-1" class="mp-container mp-section not-found">
		<section class="mp-empty" aria-labelledby="not-found-title">
			<div class="mp-empty__media"><Icon icon="search" size="lg" /></div>
			<p class="type-label mp-text" data-tone="human">HTTP 404</p>
			<h1 class="mp-empty__title type-display" id="not-found-title">Rota não encontrada</h1>
			<p class="mp-empty__body">
				O endereço existe em alguma timeline paralela, mas neste deploy ele não resolveu.
				Pode ser link antigo, typo ou cache insistente.
			</p>
			<div class="mp-empty__actions" role="group" aria-label="Próximos caminhos">
				<a class="mp-button" href="/"><Icon icon="arrow-left" /> Voltar pra home</a>
				<a class="mp-button" data-variant="ghost" href="/blog/"><Icon icon="book-open" /> Ler o blog</a>
				<a class="mp-button" data-variant="ghost" href="/dev/"><Icon icon="square-terminal" /> Ver /dev</a>
			</div>
			<p class="mp-text type-small" data-tone="muted">
				Se esse link saiu de algum conteúdo meu, me manda um ping em <a class="mp-link" href="/contact/">contato</a>
				que eu corrijo a rota.
			</p>
		</section>

		<figure class="mp-code-block not-found__terminal" data-theme="dark" aria-label="Diagnóstico da rota">
			<div class="mp-code-block__header"><span>terminal</span><span>404</span></div>
			<pre tabindex="0"><code><span class="mp-syntax-keyword">$</span> <span class="mp-syntax-function">fetch</span>(currentRoute)
<span class="mp-syntax-comment">status:</span> <span class="mp-syntax-number">404</span>
<span class="mp-syntax-comment">hint:</span> recalcular rota conhecida
&#123;
  <span class="mp-syntax-string">"fallback"</span>: [<span class="mp-syntax-string">"/"</span>, <span class="mp-syntax-string">"/work/"</span>, <span class="mp-syntax-string">"/blog/"</span>, <span class="mp-syntax-string">"/dev/"</span>],
  <span class="mp-syntax-string">"cause"</span>: <span class="mp-syntax-string">"resource_not_found"</span>,
  <span class="mp-syntax-string">"next"</span>: <span class="mp-syntax-string">"choose_a_checkpoint"</span>
&#125;</code></pre>
		</figure>
	</main>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		gap: var(--space-10);
		align-items: center;
	}

	.not-found__terminal {
		width: 100%;
		max-width: var(--container-sm);
		margin-inline: auto;
	}

	@media (min-width: 60em) {
		.not-found {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
