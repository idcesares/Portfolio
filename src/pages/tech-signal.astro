---
import MainHead from '../components/MainHead.astro';
import {
  AUTHOR_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  SOCIAL_LINKS,
} from '../utils/seo';
import {
  CATEGORIES,
  CURATED_AT,
  CURATED_LABEL,
  SOURCES,
  TIER_DESC,
  TIER_NAME,
  countByCategory,
  type SignalSource,
} from '../data/tech-signal-sources';

export const prerender = true;

const title = 'Tech Signal Stack';
const description =
  'Curadoria pessoal e opinativa das fontes de maior sinal em tecnologia, IA, engenharia, negócios, política e educação, com peso real para o que se publica no Brasil.';
const canonicalPath = '/tech-signal/';
const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(canonicalPath, baseUrl);
const siteUrl = new URL('/', baseUrl);
const image = '/favicon.svg';

// Ordenação canônica: tier primeiro, depois alfabética. Como os cards são
// renderizados no servidor, o DOM já sai na ordem certa e o filtro do cliente
// só esconde o que não casa.
const orderedSources: SignalSource[] = [...SOURCES].sort(
  (a, b) => a.tier - b.tier || a.name.localeCompare(b.name, 'pt-BR')
);

const brazilianCount = SOURCES.filter(
  (source) => source.region === 'Brasil' || source.region === 'LATAM'
).length;
const categoryCount = CATEGORIES.length - 1;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Tech Signal Stack',
  headline: 'Tech Signal Stack',
  description,
  url: pageUrl.toString(),
  inLanguage: 'pt-BR',
  dateModified: CURATED_AT,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: siteUrl.toString(),
    description: SITE_DESCRIPTION,
  },
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: siteUrl.toString(),
    sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: siteUrl.toString(),
  },
  about: [
    'Inteligência em tecnologia',
    'Inteligência artificial',
    'Engenharia de software',
    'Negócios e estratégia em tecnologia',
    'Política e regulação de tecnologia',
    'Educação e tecnologia',
    'Tecnologia no Brasil',
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: 'Fontes curadas de inteligência em tecnologia',
    description:
      'Diretório de fontes organizado por categoria, prioridade, cadência, região e modelo de acesso.',
    numberOfItems: orderedSources.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: orderedSources.map((source, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: source.name,
      url: source.url,
      description: source.desc,
    })),
  },
};

const cleanUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const accessLabel = (access: SignalSource['access']) =>
  access === 'aberto' ? 'Aberto' : 'Assinatura';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<MainHead
  title={title}
  description={description}
  image={image}
  imageAlt="Ícone de Isaac D'Césares usado como prévia social do Tech Signal Stack"
  structuredData={structuredData}
/>
<link rel="alternate" hreflang="pt-BR" href={pageUrl.toString()}>
<link rel="alternate" hreflang="x-default" href={pageUrl.toString()}>
<style is:global>
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0ms !important;
    animation-duration: 0ms !important;
    animation-delay: 0ms !important;
    scroll-behavior: auto !important;
  }
}

/* ═══════════ MOTION ═══════════ */
@keyframes rise-in {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes header-in {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes line-grow {
  from { transform: scaleX(0); }
  to   { transform: scaleX(1); }
}

/* ═══════════ RESET & BASE ═══════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-sans);
  background: var(--color-bg-primary);
  background-image: var(--gradient-warmth);
  background-attachment: fixed;
  color: var(--color-text-primary);
  line-height: 1.6;
  min-height: 100vh;
  transition: background-color var(--duration-normal) var(--ease-default),
              color var(--duration-normal) var(--ease-default);
}
a { color: inherit; text-decoration: none; }
button { cursor: pointer; font-family: var(--font-sans); border: none; background: none; }

.skip-link {
  position: absolute; left: -999px; top: 0; z-index: 999;
  background: var(--color-terracotta); color: var(--color-text-on-accent);
  padding: var(--space-3) var(--space-5); border-radius: 0 0 var(--radius-md) 0;
  font-size: 0.875rem; font-weight: 500;
}
.skip-link:focus { left: 0; }

/* ═══════════ HEADER ═══════════ */
.site-header {
  background: var(--color-charcoal);
  position: relative; overflow: hidden;
  padding: var(--space-16) var(--site-margin) var(--space-12);
}
[data-theme="dark"] .site-header { background: var(--color-charcoal); }
.header-ambient {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse at 8% 60%, color-mix(in srgb, var(--color-terracotta) 20%, transparent) 0%, transparent 50%),
    radial-gradient(ellipse at 88% 15%, color-mix(in srgb, var(--color-teal) 16%, transparent) 0%, transparent 48%);
}
.header-wordmark {
  position: absolute; bottom: -0.12em; right: -0.02em;
  font-family: var(--font-serif); font-weight: 700;
  font-size: clamp(5rem, 19vw, 13rem); line-height: 1;
  color: color-mix(in srgb, var(--color-cream) 4%, transparent); letter-spacing: 0;
  pointer-events: none; user-select: none;
  font-variation-settings: "WONK" 1;
}
.header-inner {
  position: relative; z-index: 2;
  max-width: var(--container-xl); margin: 0 auto;
  display: flex; flex-direction: column; gap: var(--space-5);
}
.header-inner > * { animation: header-in var(--duration-slow) var(--ease-out) both; }
.header-eyebrow   { animation-delay: 60ms; }
.header-headline  { animation-delay: 140ms; }
.header-meta      { animation-delay: 240ms; }
.header-eyebrow {
  font-size: 0.75rem; font-weight: 500; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--color-terracotta);
  display: flex; align-items: center; gap: var(--space-2);
}
.header-eyebrow::before {
  content: ''; width: 24px; height: 1px;
  background: var(--color-terracotta); opacity: 0.55;
}
.header-headline {
  font-family: var(--font-serif); font-weight: 700;
  font-size: var(--text-display); line-height: 1.04;
  letter-spacing: 0; color: var(--color-cream);
  font-variation-settings: "WONK" 1; max-width: 16ch;
}
.header-headline em { font-style: italic; color: var(--color-amber); }
.header-meta {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: var(--space-10); flex-wrap: wrap;
}
.header-desc {
  font-size: 1.0625rem; color: color-mix(in srgb, var(--color-cream) 60%, transparent);
  max-width: 54ch; line-height: 1.65;
}
.header-stats { display: flex; gap: var(--space-8); flex-shrink: 0; }
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat-num {
  font-family: var(--font-serif); font-size: 1.875rem; font-weight: 700;
  color: var(--color-cream); line-height: 1; font-variation-settings: "WONK" 1;
}
.stat-label {
  font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em;
  text-transform: uppercase; color: color-mix(in srgb, var(--color-cream) 40%, transparent);
}
.membrane-line {
  height: 3px; background: var(--gradient-membrane);
  transform-origin: left center;
  animation: line-grow var(--duration-slower, 600ms) var(--ease-out) 360ms both;
}

/* ═══════════ CONTROLS (sticky) ═══════════ */
.controls {
  position: sticky; top: 0; z-index: 100;
  background: color-mix(in srgb, var(--color-bg-secondary) 88%, transparent);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border-default);
  transition: background-color var(--duration-normal), border-color var(--duration-normal);
}
.controls-inner {
  max-width: var(--container-xl); margin: 0 auto;
  padding: var(--space-3) var(--site-margin);
  display: flex; flex-direction: column; gap: var(--space-3);
}
.controls-top {
  display: flex; align-items: center; gap: var(--space-3);
}
/* Search */
.search-wrap {
  flex: 1; position: relative; display: flex; align-items: center;
  min-width: 0;
}
.search-icon {
  position: absolute; left: var(--space-3); color: var(--color-text-tertiary);
  pointer-events: none; display: flex;
}
.search-input {
  width: 100%; font-family: var(--font-sans); font-size: 0.9375rem;
  color: var(--color-text-primary);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-full);
  padding: var(--space-2) var(--space-10) var(--space-2) 2.5rem;
  transition: border-color var(--duration-fast), box-shadow var(--duration-fast);
}
.search-input::placeholder { color: var(--color-text-tertiary); }
.search-input:focus {
  outline: none; border-color: var(--color-teal);
  box-shadow: 0 0 0 3px var(--color-teal-10);
}
.search-clear {
  position: absolute; right: var(--space-1);
  width: var(--size-touch-target); height: var(--size-touch-target); border-radius: 50%;
  display: none; align-items: center; justify-content: center;
  color: var(--color-text-tertiary);
  transition: background var(--duration-fast), color var(--duration-fast);
}
.search-clear:hover { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
.search-clear.visible { display: flex; }
.theme-toggle {
  width: var(--size-touch-target); height: var(--size-touch-target); flex-shrink: 0;
  border: 1px solid var(--color-border-default); border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  display: flex; align-items: center; justify-content: center;
  transition: all var(--duration-fast) var(--ease-default);
}
.theme-toggle:hover { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
.theme-toggle:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

/* Filter pills */
.filter-row {
  display: flex; gap: var(--space-2); overflow-x: auto;
  scrollbar-width: none; -ms-overflow-style: none;
  padding-bottom: 2px;
}
.filter-row::-webkit-scrollbar { display: none; }
.filter-pill {
  font-size: 0.78rem; font-weight: 500; letter-spacing: 0.01em;
  min-height: var(--size-touch-target);
  color: var(--color-text-secondary);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-default);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-full); white-space: nowrap;
  display: flex; align-items: center; gap: var(--space-2);
  transition: all var(--duration-fast) var(--ease-default);
}
.filter-pill:hover {
  border-color: var(--color-border-emphasis);
  color: var(--color-text-primary);
}
.filter-pill.active {
  background: var(--color-terracotta); border-color: var(--color-terracotta);
  color: var(--color-text-on-accent);
}
.filter-pill .pill-count {
  font-family: var(--font-mono); font-size: 0.62rem;
  opacity: 0.65; font-weight: 400;
}
.filter-pill.active .pill-count { opacity: 0.85; }
.filter-pill:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

/* ═══════════ MAIN ═══════════ */
main { max-width: var(--container-xl); margin: 0 auto; padding: var(--space-10) var(--site-margin) var(--space-24); }

/* Strategy panel */
.strategy {
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-8);
  animation: rise-in var(--duration-slow) var(--ease-out) 440ms both;
  margin-bottom: var(--space-10);
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6);
  position: relative; overflow: hidden;
}
.strategy::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--gradient-membrane);
}
.strat-item { display: flex; flex-direction: column; gap: var(--space-1); }
.strat-label {
  font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--color-text-tertiary);
}
.strat-title {
  font-family: var(--font-serif); font-size: 1.0625rem; font-weight: 600;
  color: var(--color-text-primary); font-variation-settings: "WONK" 1;
  display: flex; align-items: center; gap: var(--space-2);
}
.strat-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.dot-t { background: var(--color-terracotta); }
.dot-a { background: var(--color-amber); }
.dot-d { background: var(--color-teal); }
.strat-desc { font-size: 0.8125rem; color: var(--color-text-secondary); line-height: 1.5; }

/* Result meta line */
.result-meta {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-4); margin-bottom: var(--space-5); flex-wrap: wrap;
}
.result-meta-left { display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; }
.result-title {
  font-family: var(--font-serif); font-size: var(--text-h3); font-weight: 600;
  color: var(--color-text-primary); font-variation-settings: "WONK" 1;
}
.result-count {
  font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-tertiary);
}

/* Tier segmented control */
.tier-control {
  display: inline-flex; align-items: center; gap: var(--space-2);
  min-width: 0;
}
.tier-control-label {
  font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--color-text-tertiary);
  margin-right: var(--space-1); flex-shrink: 0;
}
.tier-seg {
  display: inline-flex; background: var(--color-bg-secondary);
  border: 1px solid var(--color-border-default); border-radius: var(--radius-full);
  padding: 3px; max-width: 100%; overflow-x: auto;
  scrollbar-width: none; -ms-overflow-style: none;
}
.tier-seg::-webkit-scrollbar { display: none; }
.tier-btn {
  font-family: var(--font-sans); font-size: 0.72rem; font-weight: 500;
  min-height: calc(var(--size-touch-target) - 8px);
  color: var(--color-text-secondary);
  padding: var(--space-1) var(--space-3); border-radius: var(--radius-full);
  display: inline-flex; align-items: center; gap: var(--space-1);
  transition: all var(--duration-fast) var(--ease-default);
  white-space: nowrap;
}
.tier-btn:hover { color: var(--color-text-primary); }
.tier-btn .tier-tick { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.tier-btn[data-tier="1"] .tier-tick { background: var(--color-terracotta); }
.tier-btn[data-tier="2"] .tier-tick { background: var(--color-teal); }
.tier-btn[data-tier="3"] .tier-tick { background: var(--color-neutral-300); }
.tier-btn.active { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
.tier-btn.active[data-tier="1"] { background: var(--color-terracotta-10); color: var(--color-terracotta); }
.tier-btn.active[data-tier="2"] { background: var(--color-teal-10); color: var(--color-teal); }
.tier-btn:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

/* ═══════════ CARD GRID ═══════════ */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--space-4);
}
.card {
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border-default);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-6);
  display: flex; flex-direction: column; gap: var(--space-3);
  position: relative; overflow: hidden;
  transition: transform var(--duration-slow) var(--ease-out),
              box-shadow var(--duration-slow) var(--ease-out),
              border-color var(--duration-normal) var(--ease-default),
              background-color var(--duration-normal) var(--ease-default);
  animation: rise-in var(--duration-slow) var(--ease-out) both;
  animation-delay: calc(var(--i, 0) * 28ms);
}
.card::before {
  content: ''; position: absolute; top: 0; left: 0;
  width: 3px; height: 100%;
}
.card.t1::before { background: var(--color-terracotta); }
.card.t2::before { background: var(--color-teal); }
.card.t3::before { background: var(--color-neutral-300); }
.card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--color-border-emphasis); }
.card.t1:hover { box-shadow: var(--shadow-md), var(--shadow-glow-warm); }
.card.t2:hover { box-shadow: var(--shadow-md), var(--shadow-glow-teal); }
.card:has(.card-link:focus-visible) {
  outline: var(--focus-ring); outline-offset: var(--focus-ring-offset);
}
.card-link { display: inline; }
.card-link::after { content: ''; position: absolute; inset: 0; z-index: 0; }
.card-link:focus { outline: none; }
.card-body { position: relative; z-index: 1; pointer-events: none; }
.card-body a { pointer-events: auto; }
.card:hover .card-arrow { opacity: 1; color: var(--color-terracotta); transform: translate(3px,-3px); }

.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2); }
.card-title-wrap { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; min-width: 0; }
.card-tier {
  align-self: flex-start; position: relative; z-index: 1;
  min-height: 28px;
  font-family: var(--font-sans); font-size: 0.64rem; font-weight: 500;
  letter-spacing: 0.02em;
  padding: 2px var(--space-2); border-radius: var(--radius-full);
  display: inline-flex; align-items: center; gap: 5px;
  cursor: pointer; border: 1px solid transparent;
  transition: all var(--duration-fast) var(--ease-default);
}
.card-tier .tier-tick { width: 6px; height: 6px; border-radius: 50%; }
.card-tier[data-tier="1"] { background: var(--color-terracotta-10); color: var(--color-terracotta); }
.card-tier[data-tier="1"] .tier-tick { background: var(--color-terracotta); }
.card-tier[data-tier="2"] { background: var(--color-teal-10); color: var(--color-teal); }
.card-tier[data-tier="2"] .tier-tick { background: var(--color-teal); }
.card-tier[data-tier="3"] { background: var(--color-bg-tertiary); color: var(--color-text-tertiary); }
.card-tier[data-tier="3"] .tier-tick { background: var(--color-neutral-300); }
.card-tier:hover { border-color: currentColor; }
.card-tier:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
.card-title {
  font-family: var(--font-serif); font-size: var(--text-h4); font-weight: 600;
  color: var(--color-text-primary); line-height: 1.2;
  font-variation-settings: "WONK" 1;
}
.card-arrow {
  font-size: 12px; color: var(--color-text-tertiary); flex-shrink: 0; margin-top: 3px;
  opacity: 0; transition: opacity var(--duration-fast), transform var(--duration-fast), color var(--duration-fast);
}
.card-url { font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-tertiary); letter-spacing: 0.01em; }
.card-desc { font-size: 0.84rem; color: var(--color-text-secondary); line-height: 1.55; flex: 1; }
.card-foot { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-top: var(--space-1); }
.tag {
  font-size: 0.62rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;
  padding: 2px var(--space-3); border-radius: var(--radius-full); line-height: 1.7;
}
.tag-cadence { background: var(--color-terracotta-10); color: var(--color-terracotta); }
.tag-deep    { background: var(--color-teal-10);       color: var(--color-teal); }
.tag-topic   { background: var(--color-bg-tertiary);   color: var(--color-text-tertiary); }
.tag-region  { background: var(--color-sage-10);       color: var(--color-success-text); }
.access {
  margin-left: auto; font-family: var(--font-mono); font-size: 0.6rem;
  letter-spacing: 0.04em; text-transform: uppercase;
  padding: 2px var(--space-2); border-radius: var(--radius-sm);
}
.access-free { background: var(--color-sage-10); color: var(--color-success-text); }
.access-paid { background: var(--color-amber-10); color: var(--color-warning-text); }

/* Filtro: os cards existem no HTML servido e sao apenas ocultados. */
.card[hidden] { display: none; }

/* Utilitario de leitor de tela */
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

/* Volta para o portfolio */
.header-back {
  display: inline-flex; align-items: center; gap: var(--space-2);
  min-height: var(--size-touch-target);
  font-size: 0.8125rem; font-weight: 500;
  color: color-mix(in srgb, var(--color-cream) 60%, transparent);
  transition: color var(--duration-fast) var(--ease-default);
}
.header-back:hover { color: var(--color-amber); }
.header-back:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }
.footer-back {
  display: inline-flex; align-items: center; min-height: var(--size-touch-target);
  font-size: 0.8125rem; font-weight: 500; color: var(--color-teal);
  border-bottom: 1px solid transparent;
}
.footer-back:hover { border-bottom-color: var(--color-teal); }
.footer-back:focus-visible { outline: var(--focus-ring); outline-offset: var(--focus-ring-offset); }

/* Nota de método */
.method {
  margin-top: var(--space-12); padding: var(--space-6) var(--space-8);
  border: 1px solid var(--color-border-default); border-radius: var(--radius-xl);
  background: var(--color-bg-secondary);
}
.method h2 {
  font-family: var(--font-serif); font-size: var(--text-h3); font-weight: 600;
  color: var(--color-text-primary); font-variation-settings: "WONK" 1;
  margin-bottom: var(--space-3);
}
.method p {
  font-size: 0.9375rem; color: var(--color-text-secondary);
  line-height: 1.7; max-width: 68ch;
}
.method p + p { margin-top: var(--space-3); }

/* Highlight (search match) */
mark { background: var(--color-amber); color: var(--color-charcoal); border-radius: 2px; padding: 0 1px; }

/* Empty state */
.empty {
  display: none; text-align: center; padding: var(--space-20) var(--space-4);
  color: var(--color-text-tertiary);
}
.empty.visible { display: block; }
.empty-glyph {
  font-family: var(--font-serif); font-size: 3rem; font-weight: 700;
  color: var(--color-border-emphasis); font-variation-settings: "WONK" 1;
  margin-bottom: var(--space-4);
}
.empty-text { font-size: 1rem; margin-bottom: var(--space-2); color: var(--color-text-secondary); }
.empty-sub { font-size: 0.875rem; }
.empty-reset {
  margin-top: var(--space-5); font-size: 0.875rem; font-weight: 500;
  color: var(--color-teal); border-bottom: 1px solid transparent;
  transition: border-color var(--duration-fast);
}
.empty-reset:hover { border-bottom-color: var(--color-teal); }

/* ═══════════ FOOTER ═══════════ */
.site-footer { border-top: 1px solid var(--color-border-default); padding: var(--space-8) var(--site-margin); }
.footer-inner {
  max-width: var(--container-xl); margin: 0 auto;
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--space-4); flex-wrap: wrap;
}
.footer-brand {
  font-family: var(--font-serif); font-weight: 700; font-size: 1rem;
  font-variation-settings: "WONK" 1; color: var(--color-terracotta);
}
.footer-brand .sep { color: var(--color-teal); }
.footer-brand .sub { font-family: var(--font-sans); font-weight: 400; font-size: 0.75rem; color: var(--color-text-tertiary); margin-left: var(--space-2); }
.footer-note { font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-tertiary); letter-spacing: 0.03em; }

/* ═══════════ RESPONSIVE ═══════════ */
@media (max-width: 820px) {
  .strategy { grid-template-columns: 1fr; gap: var(--space-5); }
  .header-meta { flex-direction: column; align-items: flex-start; gap: var(--space-6); }
}
@media (max-width: 560px) {
  .header-stats { gap: var(--space-6); }
  .grid { grid-template-columns: 1fr; }
  .footer-inner { flex-direction: column; align-items: flex-start; }
  .controls-top { flex-wrap: wrap; }
}
</style>
</head>
<body>
<a href="#main" class="skip-link">Pular para as fontes</a>

<header class="site-header">
  <div class="header-ambient" aria-hidden="true"></div>
  <div class="header-wordmark" aria-hidden="true">Signal</div>
  <div class="header-inner">
    <a href="/dev/" class="header-back">← Voltar para o portfólio</a>
    <p class="header-eyebrow">Dieta de informação · {CURATED_LABEL}</p>
    <h1 class="header-headline">Tech <em>Signal</em> Stack.</h1>
    <div class="header-meta">
      <p class="header-desc">Curadoria opinativa das fontes de maior sinal em tecnologia. Feita para prática diária, não para rolagem passiva. Cada fonte precisa justificar o lugar que ocupa, e o que se publica no Brasil conta como fonte primária, não como nota de rodapé.</p>
      <div class="header-stats">
        <div class="stat"><span class="stat-num">{orderedSources.length}</span><span class="stat-label">fontes</span></div>
        <div class="stat"><span class="stat-num">{brazilianCount}</span><span class="stat-label">do Brasil</span></div>
        <div class="stat"><span class="stat-num">{categoryCount}</span><span class="stat-label">categorias</span></div>
      </div>
    </div>
  </div>
</header>
<div class="membrane-line"></div>

<nav class="controls" aria-label="Busca e filtros">
  <div class="controls-inner">
    <div class="controls-top">
      <div class="search-wrap">
        <span class="search-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="search" id="search" class="search-input" placeholder="Buscar por fonte, tema ou nome…" aria-label="Buscar fontes" autocomplete="off">
        <button type="button" class="search-clear" id="searchClear" aria-label="Limpar busca">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <button type="button" class="theme-toggle" id="themeToggle" aria-label="Alternar modo escuro" title="Alternar tema"></button>
    </div>
    <div class="filter-row" id="filterRow" role="group" aria-label="Filtrar por categoria">
      {CATEGORIES.map((cat) => (
        <button
          type="button"
          class:list={['filter-pill', { active: cat.id === 'todas' }]}
          data-filter={cat.id}
          aria-pressed={cat.id === 'todas' ? 'true' : 'false'}
        >
          {cat.label} <span class="pill-count">{countByCategory(cat.id)}</span>
        </button>
      ))}
    </div>
  </div>
</nav>

<main id="main">
  <div class="strategy" aria-label="Estratégia de leitura sugerida">
    <div class="strat-item">
      <span class="strat-label">Varredura da manhã · 15 min</span>
      <span class="strat-title"><span class="strat-dot dot-t"></span>Ficar em dia</span>
      <p class="strat-desc">Hacker News, TLDR, Tecnoblog, The Verge. Cobre a maior parte do que importa, com pouca repetição entre eles.</p>
    </div>
    <div class="strat-item">
      <span class="strat-label">Síntese semanal · domingo</span>
      <span class="strat-title"><span class="strat-dot dot-a"></span>Pensar estratégia</span>
      <p class="strat-desc">Stratechery, Benedict Evans, Exponential View, Manual do Usuário. A camada que a notícia diária não alcança.</p>
    </div>
    <div class="strat-item">
      <span class="strat-label">Sob demanda · quando pesa</span>
      <span class="strat-title"><span class="strat-dot dot-d"></span>Ir fundo</span>
      <p class="strat-desc">Ars Technica, MIT Tech Review, Cetic.br, JOTA, Rest of World. Para quando a manchete não basta.</p>
    </div>
  </div>

  <div class="result-meta">
    <div class="result-meta-left">
      <h2 class="result-title" id="resultTitle">Todas as fontes</h2>
      <span class="result-count" id="resultCount" role="status" aria-live="polite"></span>
    </div>
    <div class="tier-control">
      <span class="tier-control-label">Prioridade</span>
      <div class="tier-seg" id="tierSeg" role="group" aria-label="Filtrar por prioridade">
        <button type="button" class="tier-btn active" data-tier="todas" aria-pressed="true">Todas</button>
        <button type="button" class="tier-btn" data-tier="1" aria-pressed="false" title={TIER_DESC[1]}><span class="tier-tick"></span>{TIER_NAME[1]}</button>
        <button type="button" class="tier-btn" data-tier="2" aria-pressed="false" title={TIER_DESC[2]}><span class="tier-tick"></span>{TIER_NAME[2]}</button>
        <button type="button" class="tier-btn" data-tier="3" aria-pressed="false" title={TIER_DESC[3]}><span class="tier-tick"></span>{TIER_NAME[3]}</button>
      </div>
    </div>
  </div>

  <div class="grid" id="grid">
    {orderedSources.map((source, index) => (
      <article
        class:list={['card', `t${source.tier}`]}
        data-tier={source.tier}
        data-cats={source.cats.join(' ')}
        data-haystack={[source.name, source.desc, source.topics.join(' '), source.region, source.url].join(' ').toLowerCase()}
        style={`--i:${Math.min(index, 14)}`}
      >
        <div class="card-head">
          <div class="card-title-wrap">
            <button
              type="button"
              class="card-tier"
              data-tier={source.tier}
              title={`${TIER_DESC[source.tier]}. Clique para filtrar.`}
              aria-label={`${TIER_DESC[source.tier]}. Filtrar por esta prioridade.`}
            ><span class="tier-tick"></span>{TIER_NAME[source.tier]}</button>
            <h3 class="card-title" data-original={source.name}>
              <a class="card-link" href={source.url} target="_blank" rel="noopener noreferrer">
                {source.name}<span class="sr-only"> (abre em uma nova aba)</span>
              </a>
            </h3>
          </div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </div>
        <div class="card-body">
          <p class="card-url">{cleanUrl(source.url)}</p>
          <p class="card-desc" data-original={source.desc}>{source.desc}</p>
        </div>
        <div class="card-foot">
          <span class="tag tag-cadence">{source.cadence}</span>
          {source.deep && <span class="tag tag-deep">Aprofundado</span>}
          <span class="tag tag-region">{source.region}</span>
          {source.topics.map((topic) => <span class="tag tag-topic">{topic}</span>)}
          <span class:list={['access', source.access === 'aberto' ? 'access-free' : 'access-paid']}>{accessLabel(source.access)}</span>
        </div>
      </article>
    ))}
  </div>

  <div class="empty" id="empty">
    <div class="empty-glyph" aria-hidden="true">∅</div>
    <p class="empty-text">Nenhuma fonte corresponde.</p>
    <p class="empty-sub">Tente outro termo, categoria ou prioridade.</p>
    <button type="button" class="empty-reset" id="emptyReset">Limpar filtros</button>
  </div>

  <section class="method" aria-labelledby="methodTitle">
    <h2 id="methodTitle" class="result-title" style="font-size: var(--text-h3)">Como esta lista é feita</h2>
    <p>Uma fonte entra aqui quando passa em três perguntas. Ela publica apuração própria, ou só recircula o que outros publicaram? Ela sustenta o que afirma com dado, documento ou fonte que dá para conferir? E ela me faz mudar de ideia sobre alguma coisa com alguma frequência, ou apenas confirma o que eu já pensava?</p>
    <p>A prioridade não mede qualidade, mede frequência de uso. Essencial é o que eu leio de forma recorrente. Forte é excelente, e o peso depende do papel de quem lê. Situacional é o que eu procuro quando o assunto específico aparece. Um veículo excelente pode ser situacional, e isso não é demérito.</p>
    <p>Veículos brasileiros de alto volume e baixa apuração ficaram de fora de propósito. A lista prioriza quem produz reportagem, pesquisa ou dado primário sobre tecnologia no Brasil, porque essa camada quase não aparece na cobertura internacional e é justamente onde eu trabalho.</p>
    <p>A curadoria é revisada periodicamente e cada revisão tira fontes, não só acrescenta. Se você acha que falta alguma, ou que alguma aqui não merece mais o lugar, me escreve. Vamos cocriar?</p>
  </section>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-brand">d<span class="sep">'</span>c<span class="sub">Signal Stack</span></span>
    <p class="footer-note">{orderedSources.length} fontes · revisado em {CURATED_LABEL}</p>
    <a class="footer-back" href="/dev/">Ver o resto do portfólio</a>
  </div>
</footer>

<script is:inline>
/* ═══════════════════════════════════════════════
   Os cards já vêm renderizados do servidor. Este script só filtra,
   busca e destaca. Sem JS a página continua completa e legível.
═══════════════════════════════════════════════ */
const grid        = document.getElementById('grid');
const filterRow   = document.getElementById('filterRow');
const searchInput = document.getElementById('search');
const searchClear = document.getElementById('searchClear');
const emptyState  = document.getElementById('empty');
const resultTitle = document.getElementById('resultTitle');
const resultCount = document.getElementById('resultCount');
const tierSeg     = document.getElementById('tierSeg');
const cards       = Array.from(grid.querySelectorAll('.card'));

const CATEGORY_LABELS = {};
filterRow.querySelectorAll('.filter-pill').forEach(pill => {
  CATEGORY_LABELS[pill.dataset.filter] = pill.textContent.replace(/\s*\d+\s*$/, '').trim();
});
const TIER_NAME = { 1: 'Essencial', 2: 'Forte', 3: 'Situacional' };

let activeFilter = 'todas';
let activeTier   = 'todas';
let searchTerm   = '';

const escapeHTML = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function highlight(text, term) {
  const safe = escapeHTML(text);
  if (!term) return safe;
  const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
  return safe.replace(re, '<mark>$1</mark>');
}

function paintHighlights(card, term) {
  const title = card.querySelector('.card-title');
  const desc  = card.querySelector('.card-desc');
  const link  = title.querySelector('.card-link');
  link.innerHTML = highlight(title.dataset.original, term)
    + '<span class="sr-only"> (abre em uma nova aba)</span>';
  desc.innerHTML = highlight(desc.dataset.original, term);
}

function render() {
  const term = searchTerm.trim().toLowerCase();
  let visible = 0;

  cards.forEach(card => {
    const matchesCat  = activeFilter === 'todas' || card.dataset.cats.split(' ').includes(activeFilter);
    const matchesTier = activeTier === 'todas' || card.dataset.tier === activeTier;
    const matchesTerm = !term || card.dataset.haystack.includes(term);
    const show = matchesCat && matchesTier && matchesTerm;

    card.hidden = !show;
    if (show) {
      visible++;
      paintHighlights(card, term);
    }
  });

  let title = activeFilter === 'todas' ? 'Todas as fontes' : CATEGORY_LABELS[activeFilter];
  if (activeTier !== 'todas') title += ' · ' + TIER_NAME[activeTier];
  resultTitle.textContent = title;
  resultCount.textContent = visible === 1 ? '1 fonte' : visible + ' fontes';

  const isEmpty = visible === 0;
  emptyState.classList.toggle('visible', isEmpty);
  grid.style.display = isEmpty ? 'none' : 'grid';
}

function setCategory(id) {
  activeFilter = id;
  filterRow.querySelectorAll('.filter-pill').forEach(pill => {
    const on = pill.dataset.filter === id;
    pill.classList.toggle('active', on);
    pill.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  render();
}

function setTier(tier) {
  activeTier = tier;
  tierSeg.querySelectorAll('.tier-btn').forEach(btn => {
    const on = btn.dataset.tier === tier;
    btn.classList.toggle('active', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  render();
}

filterRow.querySelectorAll('.filter-pill').forEach(pill => {
  pill.addEventListener('click', () => setCategory(pill.dataset.filter));
});

tierSeg.querySelectorAll('.tier-btn').forEach(btn => {
  btn.addEventListener('click', () => setTier(btn.dataset.tier));
});

// Selo de prioridade dentro do card também filtra. Clicar de novo no ativo limpa.
grid.addEventListener('click', e => {
  const badge = e.target.closest('.card-tier');
  if (!badge) return;
  setTier(activeTier === badge.dataset.tier ? 'todas' : badge.dataset.tier);
  window.scrollTo({ top: document.querySelector('.result-meta').offsetTop - 80, behavior: 'smooth' });
});

let searchTimer;
searchInput.addEventListener('input', e => {
  searchTerm = e.target.value;
  searchClear.classList.toggle('visible', searchTerm.length > 0);
  clearTimeout(searchTimer);
  searchTimer = setTimeout(render, 120);
});
searchClear.addEventListener('click', () => {
  searchTerm = '';
  searchInput.value = '';
  searchClear.classList.remove('visible');
  searchInput.focus();
  render();
});
searchInput.addEventListener('keydown', e => { if (e.key === 'Escape') searchClear.click(); });

document.getElementById('emptyReset').addEventListener('click', () => {
  searchTerm = '';
  searchInput.value = '';
  searchClear.classList.remove('visible');
  setCategory('todas');
  setTier('todas');
});

// Atalho: "/" foca a busca.
document.addEventListener('keydown', e => {
  if (e.key === '/' && document.activeElement !== searchInput) {
    e.preventDefault();
    searchInput.focus();
  }
});

/* ═══════════ TEMA ═══════════
   Mesma chave e mesmas classes do resto do site (ThemeToggle + MainHead),
   para o modo escuro não se perder ao navegar entre as páginas.
═══════════════════════════════ */
const root = document.documentElement;
const themeToggle = document.getElementById('themeToggle');
const moon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;
const sun  = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>`;

function paintToggle(isDark) {
  themeToggle.innerHTML = isDark ? sun : moon;
  themeToggle.setAttribute('aria-label', isDark ? 'Mudar para o modo claro' : 'Mudar para o modo escuro');
}

// O MainHead já aplicou o tema antes da pintura. Aqui só refletimos no botão.
paintToggle(root.classList.contains('theme-dark'));

themeToggle.addEventListener('click', () => {
  const isDark = !root.classList.contains('theme-dark');
  root.classList.toggle('theme-dark', isDark);
  root.setAttribute('data-theme', isDark ? 'dark' : 'light');
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
  paintToggle(isDark);
});

render();
</script>
</body>
</html>
