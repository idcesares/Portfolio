---
import SpeedInsights from '@vercel/speed-insights/astro';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import MainHead from '../components/MainHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import {
  AUTHOR_NAME,
  SITE_DESCRIPTION,
  SITE_NAME,
  SOCIAL_LINKS,
} from '../utils/seo';
import {
  CATEGORIES,
  CURATED_AT,
  CURATED_LABEL,
  KIND_DESC,
  KIND_NAME,
  SOURCES,
  TIER_DESC,
  TIER_NAME,
  countByCategory,
  type SignalKind,
  type SignalSource,
} from '../data/tech-signal-sources';

export const prerender = true;

const title = 'Tech Signal Stack';
const description =
  'Curadoria pessoal e opinativa das fontes de maior sinal em tecnologia, IA, engenharia, negócios, política e educação, com peso real para o que se publica no Brasil.';
const canonicalPath = '/tech-signal/';
const baseUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(canonicalPath, baseUrl);
const siteUrl = new URL('/', baseUrl);
const image = '/favicon.svg';

// Ordenação canônica: tier primeiro, depois alfabética. Como os cards são
// renderizados no servidor, o DOM já sai na ordem certa e o filtro do cliente
// só esconde o que não casa.
const orderedSources: SignalSource[] = [...SOURCES].sort(
  (a, b) => a.tier - b.tier || a.name.localeCompare(b.name, 'pt-BR')
);

const brazilianCount = SOURCES.filter(
  (source) => source.region === 'Brasil' || source.region === 'LATAM'
).length;

const KIND_ORDER: SignalKind[] = ['jornalismo', 'analise', 'pesquisa', 'primaria', 'descoberta'];
const kindCounts = KIND_ORDER.map((kind) => ({
  kind,
  label: KIND_NAME[kind],
  title: KIND_DESC[kind],
  count: SOURCES.filter((source) => source.kind === kind).length,
}));
const primaryCount = SOURCES.filter(
  (source) => source.kind === 'primaria' || source.kind === 'pesquisa'
).length;
const feedCount = SOURCES.filter((source) => source.feed).length;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Tech Signal Stack',
  headline: 'Tech Signal Stack',
  description,
  url: pageUrl.toString(),
  inLanguage: 'pt-BR',
  dateModified: CURATED_AT,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: siteUrl.toString(),
    description: SITE_DESCRIPTION,
  },
  author: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: siteUrl.toString(),
    sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: siteUrl.toString(),
  },
  about: [
    'Inteligência em tecnologia',
    'Inteligência artificial',
    'Engenharia de software',
    'Negócios e estratégia em tecnologia',
    'Política e regulação de tecnologia',
    'Educação e tecnologia',
    'Tecnologia no Brasil',
  ],
  mainEntity: {
    '@type': 'ItemList',
    name: 'Fontes curadas de inteligência em tecnologia',
    description:
      'Diretório de fontes organizado por categoria, prioridade, cadência, região e modelo de acesso.',
    numberOfItems: orderedSources.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: orderedSources.map((source, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: source.name,
      url: source.url,
      description: source.desc,
    })),
  },
};

const cleanUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const accessLabel = (access: SignalSource['access']) =>
  access === 'aberto' ? 'Aberto' : 'Assinatura';
// Tier is a register: essential sources are human (terracotta), strong ones
// digital (teal), situational ones neutral.
const tierTone = (tier: SignalSource['tier']) => (tier === 1 ? 'human' : tier === 2 ? 'digital' : undefined);
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<MainHead
  title={title}
  description={description}
  image={image}
  imageAlt="Ícone de Isaac D'Césares usado como prévia social do Tech Signal Stack"
  structuredData={structuredData}
/>
<link rel="alternate" hreflang="pt-BR" href={pageUrl.toString()}>
<link rel="alternate" hreflang="x-default" href={pageUrl.toString()}>
<style is:global>
/* Page-specific layout only; everything else comes from the Membrane
   component library loaded by MainHead (global.css → membrane.css). */

.signal-header {
  position: relative;
  overflow: hidden;
  padding-block: var(--space-16) var(--space-12);
  background-image:
    radial-gradient(ellipse at 8% 60%, var(--bg-glow-terracotta), transparent 50%),
    radial-gradient(ellipse at 88% 15%, var(--bg-glow-teal), transparent 48%);
}
.signal-header__inner { position: relative; z-index: 1; }
.signal-header__wordmark {
  position: absolute; inset-block-end: -0.12em; inset-inline-end: 0;
  color: var(--color-bg-tertiary);
  font-family: var(--font-serif); font-size: clamp(5rem, 19vw, 13rem); font-weight: var(--weight-bold);
  line-height: 1; pointer-events: none; user-select: none;
}
.signal-header__title { max-width: 16ch; }
.signal-header__title em { color: var(--color-warning-text); }
.signal-header__stats { margin: 0; }
.signal-header__stats dd { margin: 0; }
.membrane-line { height: var(--border-width-thick); background: var(--gradient-membrane); }

.signal-controls {
  position: sticky; top: 0; z-index: var(--z-sticky);
  padding-block: var(--space-3);
  border-block-end: var(--border-default);
  background-color: color-mix(in srgb, var(--color-bg-secondary) 88%, transparent);
  backdrop-filter: blur(var(--blur-backdrop));
}
.signal-search { position: relative; flex: 1 1 16rem; }
.signal-search .mp-input { padding-inline-end: var(--space-12); border-radius: var(--radius-full); }
.signal-search__clear { position: absolute; inset-block: 0; inset-inline-end: var(--space-1); margin-block: auto; }
.filter-row { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-block: var(--space-1); }
.filter-row .mp-tag { min-height: var(--size-touch-target); }
.filter-row .mp-tag[aria-pressed='true'] { --mp-tag-bg: var(--color-action-primary); --mp-tag-fg: var(--color-text-on-accent); }
.pill-count { font-family: var(--font-mono); }

.signal-main { padding-block: var(--space-10) var(--space-24); }
.result-meta { scroll-margin-top: calc(var(--space-32) + var(--space-8)); }
.strategy { overflow: hidden; }
.strategy::before { content: ''; position: absolute; inset: 0 0 auto; height: var(--border-width-thick); background: var(--gradient-membrane); }
.strat-title { display: inline-flex; align-items: center; gap: var(--space-2); font-family: var(--font-serif); }

/* Tier marks: essential = human, strong = digital, situational = neutral. */
.tier-tick { display: inline-block; flex: none; width: 0.5rem; height: 0.5rem; border-radius: var(--radius-full); background-color: var(--color-border-emphasis); }
.tier-tick[data-tier='1'] { background-color: var(--color-action-primary); }
.tier-tick[data-tier='2'] { background-color: var(--color-action-secondary); }
.tier-tick[data-tier='warm'] { background-color: var(--color-warning); }

.seg { padding: var(--space-1); border: var(--border-default); border-radius: var(--radius-full); background-color: var(--color-bg-secondary); }
@media (prefers-reduced-motion: no-preference) {
  .order-btn[data-spin] svg { animation: signal-spin var(--duration-slow) var(--ease-out); }
}
@keyframes signal-spin { to { rotate: 1turn; } }

.signal-grid { --mp-grid-min: 18rem; --mp-gap: var(--space-4); }
.signal-card { --mp-card-padding: var(--space-5); border-inline-start: var(--border-width-thick) solid var(--mp-card-accent); }
.signal-card[data-tier='3'] { --mp-card-accent: var(--color-border-emphasis); }
.signal-card .mp-card__title { font-size: var(--text-h4); }
.card-url { margin: 0; color: var(--color-text-tertiary); font-family: var(--font-mono); font-size: var(--text-xs); overflow-wrap: anywhere; }
.signal-card .mp-card__body { font-size: var(--text-small); flex: 1; }
.signal-card .mp-card__footer { gap: var(--space-2); }
.card-tier { cursor: pointer; }
.picks .card-tier { cursor: default; }
.signal-card mark { padding-inline: 0.15em; border-radius: var(--radius-sm); background-color: var(--color-digital-bg); color: var(--color-digital-text); }

.method { gap: var(--space-6); }
.method-export { padding-block-start: var(--space-5); border-block-start: var(--border-default); }

.signal-footer { padding-block: var(--space-8); border-block-start: var(--border-default); }
.signal-footer__brand { display: inline-flex; border-radius: var(--radius-sm); }
</style>
</head>
<body>
<a class="mp-skip-link" href="#main">Pular para as fontes</a>
<SpeedInsights />

<!-- Always dark: data-theme flips the subtree to the dark tokens, .mp-surface
     paints it (the Membrane way to theme a region, no hard-coded colors). -->
<header class="mp-surface signal-header" data-theme="dark">
  <div class="signal-header__wordmark" aria-hidden="true">Signal</div>
  <div class="mp-container mp-stack signal-header__inner" data-gap="5">
    <a class="mp-link" data-variant="quiet" href="/">← Voltar para o portfólio</a>
    <p class="type-label mp-text" data-tone="human">Dieta de informação · {CURATED_LABEL}</p>
    <h1 class="type-display signal-header__title">Tech <em>Signal</em> Stack.</h1>
    <div class="mp-cluster" data-justify="between" data-align="start" data-gap="8">
      <p class="mp-text type-body-lg" data-tone="muted" data-measure>Curadoria opinativa das fontes de maior sinal em tecnologia. Feita para prática diária, não para rolagem passiva. Cada fonte precisa justificar o lugar que ocupa, e o que se publica no Brasil conta como fonte primária, não como nota de rodapé.</p>
      <dl class="mp-cluster signal-header__stats" data-gap="8">
        <div class="mp-stat"><dt class="mp-stat__label">fontes</dt><dd class="mp-stat__value">{orderedSources.length}</dd></div>
        <div class="mp-stat"><dt class="mp-stat__label">do Brasil</dt><dd class="mp-stat__value">{brazilianCount}</dd></div>
        <div class="mp-stat"><dt class="mp-stat__label">primárias</dt><dd class="mp-stat__value">{primaryCount}</dd></div>
      </dl>
    </div>
  </div>
</header>
<div class="membrane-line" aria-hidden="true"></div>

<nav class="signal-controls" aria-label="Busca e filtros">
  <div class="mp-container mp-stack" data-gap="3">
    <div class="mp-cluster" data-gap="2">
      <div class="signal-search">
        <label class="mp-visually-hidden" for="search">Buscar fontes</label>
        <input type="search" id="search" class="mp-input" placeholder="Buscar por fonte, tema ou nome…" autocomplete="off" aria-keyshortcuts="/">
        <button type="button" class="mp-button signal-search__clear" id="searchClear" data-variant="ghost" data-size="sm" data-icon-only aria-label="Limpar busca" hidden>
          <Icon icon="x" size="sm" />
        </button>
      </div>
      <ThemeToggle />
    </div>
    <div class="mp-cluster filter-row" id="filterRow" role="group" aria-label="Filtrar por categoria" data-gap="2">
      {CATEGORIES.map((cat) => (
        <button
          type="button"
          class="mp-tag filter-pill"
          data-filter={cat.id}
          aria-pressed={cat.id === 'todas' ? 'true' : 'false'}
        >
          {cat.label} <span class="pill-count">{countByCategory(cat.id)}</span>
        </button>
      ))}
    </div>
  </div>
</nav>

<main id="main" tabindex="-1" class="mp-container mp-stack signal-main" data-gap="10">
  <section class="mp-card strategy" aria-label="Estratégia de leitura sugerida">
    <div class="mp-grid" data-min="sm">
    <div class="mp-stack strat-item" data-gap="1">
      <span class="type-label mp-text" data-tone="subtle">Varredura da manhã · 15 min</span>
      <span class="type-h4 strat-title"><span class="tier-tick" data-tier="1" aria-hidden="true"></span>Ficar em dia</span>
      <p class="mp-text type-small" data-tone="muted">Hacker News, TLDR, Tecnoblog, The Verge. Cobre a maior parte do que importa, com pouca repetição entre eles.</p>
    </div>
    <div class="mp-stack strat-item" data-gap="1">
      <span class="type-label mp-text" data-tone="subtle">Síntese semanal · domingo</span>
      <span class="type-h4 strat-title"><span class="tier-tick" data-tier="warm" aria-hidden="true"></span>Pensar estratégia</span>
      <p class="mp-text type-small" data-tone="muted">Stratechery, Benedict Evans, Exponential View, Manual do Usuário. A camada que a notícia diária não alcança.</p>
    </div>
    <div class="mp-stack strat-item" data-gap="1">
      <span class="type-label mp-text" data-tone="subtle">Sob demanda · quando pesa</span>
      <span class="type-h4 strat-title"><span class="tier-tick" data-tier="2" aria-hidden="true"></span>Ir fundo</span>
      <p class="mp-text type-small" data-tone="muted">Ars Technica, MIT Tech Review, Cetic.br, JOTA, Rest of World. Para quando a manchete não basta.</p>
    </div>
    </div>
  </section>

  <section class="mp-stack picks" data-gap="5" id="picks" aria-labelledby="picksTitle" hidden>
    <div class="mp-cluster" data-justify="between" data-align="baseline" data-gap="4">
      <div>
        <h2 class="type-h3" id="picksTitle">Para descobrir hoje</h2>
        <p class="mp-text type-small" data-tone="muted" data-measure>Três fontes sorteadas fora do núcleo essencial, sempre com pelo menos uma brasileira e uma global. Muda a cada visita.</p>
      </div>
      <button type="button" class="mp-button" data-variant="secondary" data-size="sm" id="picksReroll">
        <span aria-hidden="true">↻</span> Sortear de novo
      </button>
    </div>
    <div class="mp-grid signal-grid" id="picksGrid"></div>
  </section>

  <div class="mp-stack result-meta" data-gap="4">
    <div class="mp-cluster" data-align="baseline" data-gap="3">
      <h2 class="type-h3" id="resultTitle">Todas as fontes</h2>
      <span class="mp-text type-small" data-tone="subtle" id="resultCount" role="status" aria-live="polite"></span>
    </div>
    <div class="mp-cluster seg-control" data-gap="2">
      <span class="type-label mp-text" data-tone="subtle">Natureza</span>
      <div class="mp-cluster seg" data-gap="1" id="kindSeg" role="group" aria-label="Filtrar por natureza da fonte">
        <button type="button" class="mp-button kind-btn" data-variant="ghost" data-size="sm" data-kind="todas" aria-pressed="true">Todas</button>
        {kindCounts.map((item) => (
          <button type="button" class="mp-button kind-btn" data-variant="ghost" data-size="sm" data-kind={item.kind} aria-pressed="false" title={item.title}>
            {item.label} <span class="mp-badge">{item.count}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="mp-cluster seg-control" data-gap="2" id="orderControl" hidden>
      <span class="type-label mp-text" data-tone="subtle">Ordem</span>
      <div class="mp-cluster seg" data-gap="1" id="orderSeg" role="group" aria-label="Ordem das fontes">
        <button type="button" class="mp-button order-btn" data-variant="ghost" data-size="sm" data-order="shuffle" aria-pressed="true" title="Muda a cada visita. Clique de novo para embaralhar outra vez.">
          <svg class="mp-icon" data-size="sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
          Embaralhada
        </button>
        <button type="button" class="mp-button order-btn" data-variant="ghost" data-size="sm" data-order="tier" aria-pressed="false" title="Essencial primeiro, depois ordem alfabética">Por prioridade</button>
      </div>
    </div>
    <div class="mp-cluster seg-control" data-gap="2">
      <span class="type-label mp-text" data-tone="subtle">Prioridade</span>
      <div class="mp-cluster seg" data-gap="1" id="tierSeg" role="group" aria-label="Filtrar por prioridade">
        <button type="button" class="mp-button tier-btn" data-variant="ghost" data-size="sm" data-tier="todas" aria-pressed="true">Todas</button>
        <button type="button" class="mp-button tier-btn" data-variant="ghost" data-size="sm" data-tier="1" aria-pressed="false" title={TIER_DESC[1]}><span class="tier-tick" data-tier="1" aria-hidden="true"></span>{TIER_NAME[1]}</button>
        <button type="button" class="mp-button tier-btn" data-variant="ghost" data-size="sm" data-tier="2" aria-pressed="false" title={TIER_DESC[2]}><span class="tier-tick" data-tier="2" aria-hidden="true"></span>{TIER_NAME[2]}</button>
        <button type="button" class="mp-button tier-btn" data-variant="ghost" data-size="sm" data-tier="3" aria-pressed="false" title={TIER_DESC[3]}><span class="tier-tick" data-tier="3" aria-hidden="true"></span>{TIER_NAME[3]}</button>
      </div>
    </div>
  </div>

  <div class="mp-grid signal-grid" id="grid">
    {orderedSources.map((source, index) => (
      <article
        class="mp-card signal-card"
        data-tone={source.tier === 2 ? 'digital' : undefined}
        data-tier={source.tier}
        data-cats={source.cats.join(' ')}
        data-kind={source.kind}
        data-order={index}
        data-haystack={[source.name, source.desc, source.topics.join(' '), source.region, KIND_NAME[source.kind], source.url].join(' ').toLowerCase()}
      >
        <div class="mp-cluster" data-justify="between" data-gap="2">
          <button
            type="button"
            class="mp-tag card-tier"
            data-tone={tierTone(source.tier)}
            data-tier={source.tier}
            title={`${TIER_DESC[source.tier]}. Clique para filtrar.`}
            aria-label={`${TIER_DESC[source.tier]}. Filtrar por esta prioridade.`}
          ><span class="tier-tick" data-tier={source.tier} aria-hidden="true"></span>{TIER_NAME[source.tier]}</button>
          <span class:list={['mp-badge']} data-tone={source.access === 'aberto' ? 'success' : 'warning'}>{accessLabel(source.access)}</span>
        </div>
        <h3 class="mp-card__title card-title" data-original={source.name}>
          <a class="mp-card__link card-link" href={source.url} target="_blank" rel="noopener noreferrer">
            {source.name}<span class="mp-visually-hidden"> (abre em uma nova aba)</span>
          </a>
        </h3>
        <p class="card-url">{cleanUrl(source.url)}</p>
        <p class="mp-card__body card-desc" data-original={source.desc}>{source.desc}</p>
        <div class="mp-card__footer">
          <span class="mp-badge" title={KIND_DESC[source.kind]}>{KIND_NAME[source.kind]}</span>
          <span class="mp-badge" data-tone="human">{source.cadence}</span>
          {source.deep && <span class="mp-badge" data-tone="digital">Aprofundado</span>}
          {source.region !== 'Global' && <span class="mp-badge" data-tone="success">{source.region}</span>}
          {source.topics.map((topic) => <span class="mp-tag">{topic}</span>)}
        </div>
      </article>
    ))}
  </div>

  <div class="mp-empty" data-variant="bordered" id="empty" hidden>
    <div class="mp-empty__media" aria-hidden="true"><Icon icon="search" size="lg" /></div>
    <p class="mp-empty__title">Nenhuma fonte corresponde.</p>
    <p class="mp-empty__body">Tente outro termo, categoria ou prioridade.</p>
    <div class="mp-empty__actions">
      <button type="button" class="mp-button" data-variant="secondary" id="emptyReset">Limpar filtros</button>
    </div>
  </div>

  <section class="mp-card method" data-variant="flat" aria-labelledby="methodTitle">
    <div class="mp-prose">
    <h2 id="methodTitle">Como esta lista é feita</h2>
    <p>Uma fonte entra aqui quando passa em três perguntas. Ela sustenta o que afirma com dado, documento ou apuração que dá para conferir? Ela cobre alguma coisa que as outras da lista não cobrem? E ela me faz mudar de ideia com alguma frequência, ou só confirma o que eu já pensava?</p>
    <p>Cada card diz qual é a natureza da fonte, e essa é a distinção que mais muda a leitura. Jornalismo é redação com apuração própria. Análise é interpretação assinada, com tese à mostra. Pesquisa é produção acadêmica ou institucional com metodologia pública. Fonte primária é a organização falando de si mesma, o que a torna parcial e indispensável ao mesmo tempo: o comunicado de um laboratório de IA ou a sanção de um regulador são o fato, não a cobertura do fato. Descoberta não publica nada de original, revela o que outros publicaram, e serve para medir o tamanho de um assunto, não para formar opinião sobre ele.</p>
    <p>A prioridade não mede qualidade, mede frequência de uso. Essencial é o que eu leio de forma recorrente. Forte é excelente, e o peso depende do papel de quem lê. Situacional é o que eu procuro quando o assunto aparece. Um veículo excelente pode ser situacional, e isso não é demérito: a ANPD e o Cetic.br publicam algumas vezes por ano, e quando publicam valem mais que um mês de notícia.</p>
    <p>A camada brasileira de reguladores e institutos é a parte que uma curadoria de tecnologia quase nunca tem. ANPD, Anatel, CADE, Banco Central e MCTI publicam o documento original dias antes de a imprensa interpretá-lo, e a interpretação erra com frequência. Junto com Cetic.br, InternetLab e Data Privacy Brasil, é onde se descobre o que de fato está sendo decidido sobre tecnologia no país.</p>
    <p>Ficaram de fora, de propósito, os portais brasileiros de alto volume e baixa apuração. Num agregador com pontuação dá para incluir e reduzir o peso deles; numa lista curada, incluir o que se pretende ignorar contradiz a promessa da lista. Pelo mesmo motivo, a revisão de outubro tirou três fontes: duas cujo próprio texto já admitia mais anúncio que apuração, e uma que repetia a pauta de outra da lista. Entraram treze, a maioria para cobrir o que faltava fora do eixo Estados Unidos e Europa Ocidental: América Latina, África, China e a pesquisa brasileira em ciência e direitos digitais.</p>
    <p>A ordem dos cards muda a cada visita, de propósito. Uma lista fixa ensina a ler sempre as mesmas cinco fontes do topo, e o objetivo aqui é o contrário: esbarrar com algo que eu ainda não li. O sorteio de cima evita o núcleo essencial e a ordem por prioridade continua a um clique de distância.</p>
    <p>A curadoria é revisada periodicamente e cada revisão corta, não só acrescenta. Se você acha que falta alguma, ou que alguma aqui não merece mais o lugar, me escreve. Vamos cocriar?</p>

    </div>
    <div class="mp-cluster method-export" data-justify="between" data-gap="6">
      <p class="mp-text method-export-text" data-measure>
        <strong>Leve a lista para o seu leitor de feeds.</strong> {feedCount} das {orderedSources.length} fontes publicam RSS ou Atom, e cada endereço foi conferido por requisição real antes de entrar no arquivo. As outras {orderedSources.length - feedCount} não têm feed próprio e ficaram de fora: endereço chutado quebra em silêncio dentro do leitor de quem importou. O arquivo vem organizado em pastas por categoria.
      </p>
      <a class="mp-button" href="/tech-signal.opml" download>
        Baixar OPML
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
</main>

<footer class="signal-footer">
  <div class="mp-container mp-cluster" data-justify="between" data-gap="4">
    <a class="signal-footer__brand" href="/" aria-label="D'Césares, página inicial"><BrandMark variant="monogram" /></a>
    <p class="mp-text type-small" data-tone="subtle">{orderedSources.length} fontes · revisado em {CURATED_LABEL}</p>
    <a class="mp-link" data-variant="standalone" href="/">Ver o resto do portfólio</a>
  </div>
</footer>

<script is:inline>
/* ═══════════════════════════════════════════════
   Os cards já vêm renderizados do servidor. Este script só filtra,
   busca e destaca. Sem JS a página continua completa e legível.
═══════════════════════════════════════════════ */
const grid        = document.getElementById('grid');
const filterRow   = document.getElementById('filterRow');
const searchInput = document.getElementById('search');
const searchClear = document.getElementById('searchClear');
const emptyState  = document.getElementById('empty');
const resultTitle = document.getElementById('resultTitle');
const resultCount = document.getElementById('resultCount');
const tierSeg     = document.getElementById('tierSeg');
const kindSeg     = document.getElementById('kindSeg');
const orderSeg    = document.getElementById('orderSeg');
const orderCtl    = document.getElementById('orderControl');
const picks       = document.getElementById('picks');
const picksGrid   = document.getElementById('picksGrid');
const cards       = Array.from(grid.querySelectorAll('.signal-card'));

const CATEGORY_LABELS = {};
filterRow.querySelectorAll('.filter-pill').forEach(pill => {
  CATEGORY_LABELS[pill.dataset.filter] = pill.textContent.replace(/\s*\d+\s*$/, '').trim();
});
const TIER_NAME = { 1: 'Essencial', 2: 'Forte', 3: 'Situacional' };

let activeFilter = 'todas';
let activeTier   = 'todas';
let activeKind   = 'todas';
let searchTerm   = '';

const KIND_LABELS = {};
kindSeg.querySelectorAll('.kind-btn').forEach(btn => {
  KIND_LABELS[btn.dataset.kind] = btn.textContent.replace(/\s*\d+\s*$/, '').trim();
});

const escapeHTML = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function highlight(text, term) {
  const safe = escapeHTML(text);
  if (!term) return safe;
  const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
  return safe.replace(re, '<mark>$1</mark>');
}

function paintHighlights(card, term) {
  const title = card.querySelector('.card-title');
  const desc  = card.querySelector('.card-desc');
  const link  = title.querySelector('.card-link');
  link.innerHTML = highlight(title.dataset.original, term)
    + '<span class="mp-visually-hidden"> (abre em uma nova aba)</span>';
  desc.innerHTML = highlight(desc.dataset.original, term);
}

function render() {
  const term = searchTerm.trim().toLowerCase();
  let visible = 0;

  cards.forEach(card => {
    const matchesCat  = activeFilter === 'todas' || card.dataset.cats.split(' ').includes(activeFilter);
    const matchesTier = activeTier === 'todas' || card.dataset.tier === activeTier;
    const matchesKind = activeKind === 'todas' || card.dataset.kind === activeKind;
    const matchesTerm = !term || card.dataset.haystack.includes(term);
    const show = matchesCat && matchesTier && matchesKind && matchesTerm;

    card.hidden = !show;
    if (show) {
      visible++;
      paintHighlights(card, term);
    }
  });

  let title = activeFilter === 'todas' ? 'Todas as fontes' : CATEGORY_LABELS[activeFilter];
  if (activeKind !== 'todas') title += ' · ' + KIND_LABELS[activeKind];
  if (activeTier !== 'todas') title += ' · ' + TIER_NAME[activeTier];
  resultTitle.textContent = title;
  resultCount.textContent = visible === 1 ? '1 fonte' : visible + ' fontes';

  const isEmpty = visible === 0;
  emptyState.hidden = !isEmpty;
  grid.hidden = isEmpty;
}

function setCategory(id) {
  activeFilter = id;
  filterRow.querySelectorAll('.filter-pill').forEach(pill => {
    const on = pill.dataset.filter === id;
    pill.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  render();
}

function setKind(kind) {
  activeKind = kind;
  kindSeg.querySelectorAll('.kind-btn').forEach(btn => {
    const on = btn.dataset.kind === kind;
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  render();
}

function setTier(tier) {
  activeTier = tier;
  tierSeg.querySelectorAll('.tier-btn').forEach(btn => {
    const on = btn.dataset.tier === tier;
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  render();
}

filterRow.querySelectorAll('.filter-pill').forEach(pill => {
  pill.addEventListener('click', () => setCategory(pill.dataset.filter));
});

tierSeg.querySelectorAll('.tier-btn').forEach(btn => {
  btn.addEventListener('click', () => setTier(btn.dataset.tier));
});

kindSeg.querySelectorAll('.kind-btn').forEach(btn => {
  btn.addEventListener('click', () => setKind(btn.dataset.kind));
});

// Selo de prioridade dentro do card também filtra. Clicar de novo no ativo limpa.
grid.addEventListener('click', e => {
  const badge = e.target.closest('.card-tier');
  if (!badge) return;
  setTier(activeTier === badge.dataset.tier ? 'todas' : badge.dataset.tier);
  document.querySelector('.result-meta').scrollIntoView({ block: 'start' });
});

let searchTimer;
searchInput.addEventListener('input', e => {
  searchTerm = e.target.value;
  searchClear.hidden = searchTerm.length === 0;
  clearTimeout(searchTimer);
  searchTimer = setTimeout(render, 120);
});
searchClear.addEventListener('click', () => {
  searchTerm = '';
  searchInput.value = '';
  searchClear.hidden = true;
  searchInput.focus();
  render();
});
searchInput.addEventListener('keydown', e => { if (e.key === 'Escape') searchClear.click(); });

document.getElementById('emptyReset').addEventListener('click', () => {
  searchTerm = '';
  searchInput.value = '';
  searchClear.hidden = true;
  setCategory('todas');
  setKind('todas');
  setTier('todas');
});

// Atalho: "/" foca a busca.
document.addEventListener('keydown', e => {
  if (e.key === '/' && !e.target.closest('input, textarea, select, [contenteditable]')) {
    e.preventDefault();
    searchInput.focus();
  }
});

/* ═══════════ EMBARALHAR ═══════════
   O HTML sai ordenado por prioridade (sem JS, é isso que se vê). No cliente,
   cada visita sorteia uma ordem nova e três fontes fora do núcleo essencial.
═══════════════════════════════ */
function randomInt(max) {
  const buf = new Uint32Array(1);
  crypto.getRandomValues(buf);
  return buf[0] % max;
}

function shuffled(list) {
  const out = list.slice();
  for (let i = out.length - 1; i > 0; i--) {
    const j = randomInt(i + 1);
    [out[i], out[j]] = [out[j], out[i]];
  }
  return out;
}

function placeCards(ordered) {
  grid.append(...ordered);
}

function setOrder(order, reshuffle) {
  orderSeg.querySelectorAll('.order-btn').forEach(btn => {
    const on = btn.dataset.order === order;
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  if (order === 'tier') {
    placeCards(cards.slice().sort((a, b) => a.dataset.order - b.dataset.order));
  } else if (reshuffle) {
    placeCards(shuffled(cards));
  }
}

const isBrazil = card => card.dataset.cats.split(' ').includes('brasil');

function pickFresh() {
  const pool = cards.filter(card => card.dataset.tier !== '1');
  const local = shuffled(pool.filter(isBrazil));
  const world = shuffled(pool.filter(card => !isBrazil(card)));
  const chosen = [local[0], world[0]];
  const rest = shuffled(pool.filter(card => !chosen.includes(card)));
  chosen.push(rest[0]);

  picksGrid.replaceChildren(...shuffled(chosen).map((card) => {
    const copy = card.cloneNode(true);
    copy.hidden = false;
    copy.removeAttribute('data-order');
    const badge = copy.querySelector('.card-tier');
    const label = document.createElement('span');
    label.className = badge.className;
    label.dataset.tier = badge.dataset.tier;
    if (badge.dataset.tone) label.dataset.tone = badge.dataset.tone;
    label.innerHTML = badge.innerHTML;
    badge.replaceWith(label);
    return copy;
  }));
  picks.hidden = false;
}

orderCtl.hidden = false;
orderSeg.querySelectorAll('.order-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const order = btn.dataset.order;
    if (order === 'shuffle') {
      btn.removeAttribute('data-spin');
      void btn.offsetWidth;
      btn.setAttribute('data-spin', '');
    }
    setOrder(order, true);
  });
});
document.getElementById('picksReroll').addEventListener('click', pickFresh);

setOrder('shuffle', true);
pickFresh();

render();
</script>
</body>
</html>
