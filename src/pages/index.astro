---
export const prerender = true;

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import DevProjectCard from '../components/DevProjectCard.astro';
import GridEnhanced from '../components/GridEnhanced.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreviewEnhanced from '../components/PortfolioPreviewEnhanced.astro';
import PostPreviewEnhanced from '../components/PostPreviewEnhanced.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Skills from '../components/Skills.astro';
import { devProjects } from '../data/dev-projects';
import { SOURCES } from '../data/tech-signal-sources';
import { getSiteStructuredData } from '../utils/seo';

import Portrait from '../assets/portrait.webp';

const work = await getCollection('work', ({ data }) => !data.draft);
const highlightedWorkIds = [
	'papert-mindstorms-construcionismo-aprendizagem-criativa',
	'learnchain-educacao-festival-ufrj-2024',
	'ia-personalizacao-educacao',
];
const projects = highlightedWorkIds.map((id) => {
	const project = work.find((entry) => entry.id === id);
	if (!project) throw new Error(`Trabalho em destaque não encontrado: ${id}`);
	return project;
});

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf())
	.slice(0, 3);

const site = Astro.site ?? new URL('https://www.dcesares.dev');
const structuredData = getSiteStructuredData(site);
const signalCount = SOURCES.length;
const signalBrazilCount = SOURCES.filter((source) => source.region === 'Brasil' || source.region === 'LATAM').length;
const featuredProjects = devProjects.filter((project) => project.featured).slice(0, 3);
---

<BaseLayout structuredData={structuredData}>
	<main id="main-content" tabindex="-1" class="mp-container mp-stack home" data-gap="16">
		<section class="home-hero mp-section" data-size="sm" aria-label="Apresentação">
			<Hero
				title="Isaac D'Césares"
				tagline="Traduzo tecnologias emergentes em experiências que ressignificam como pessoas e instituições aprendem."
				align="start"
			>
				<ul class="mp-cluster home-hero__roles" data-gap="2" aria-label="Três dimensões">
					<li><Pill tone="human"><Icon icon="book-open" /> Pesquisador</Pill></li>
					<li><Pill tone="learning"><Icon icon="university" /> Educador</Pill></li>
					<li><Pill tone="digital"><Icon icon="square-terminal" /> Desenvolvedor</Pill></li>
				</ul>
				<div class="mp-cluster" data-gap="3">
					<a class="mp-button" data-size="lg" href="/dev/">
						O que venho construindo
						<Icon icon="arrow-right" />
					</a>
					<a class="mp-button" data-variant="secondary" data-size="lg" href="/about/">Quem sou e como penso</a>
				</div>
			</Hero>
			<Image
				class="home-hero__portrait"
				alt="Isaac D'Césares, retrato de perfil"
				src={Portrait}
				loading="eager"
				fetchpriority="high"
				width={480}
				height={600}
				widths={[360, 480, 720, 960]}
				sizes="(min-width: 60em) 480px, 100vw"
			/>
		</section>

		<Skills />

		<section class="mp-stack" data-gap="8" aria-labelledby="projects-title" data-animate>
			<SectionHeader
				id="projects-title"
				title="Da pergunta ao código"
				lede="Pesquisa, ferramentas e sistemas que venho desenvolvendo. Cada projeto é um jeito de testar uma ideia no mundo."
				href="/dev/"
				cta="Explorar todos os projetos"
			/>
			<div class="mp-grid" data-min="lg" data-gap="6">
				{featuredProjects.map((project) => <DevProjectCard project={project} />)}
			</div>
		</section>

		<section class="mp-stack" data-gap="8" aria-labelledby="work-highlights-title" data-animate>
			<SectionHeader
				id="work-highlights-title"
				title="Trabalhos em destaque"
				lede="Aprendizagem, IA na educação e autonomia sobre dados e conhecimento."
				href="/work/"
				cta="Ver todos os trabalhos"
			/>
			<GridEnhanced variant="compact">
				{projects.map((project) => <PortfolioPreviewEnhanced project={project} />)}
			</GridEnhanced>
		</section>

		<section class="mp-stack" data-gap="8" aria-labelledby="posts-title" data-animate>
			<SectionHeader
				id="posts-title"
				title="Últimas postagens"
				lede="Notas técnicas e reflexões sobre educação, IA e o que tenho aprendido no caminho."
				href="/blog/"
				cta="Ler todas as postagens"
			/>
			<GridEnhanced variant="compact">
				{posts.map((post) => <PostPreviewEnhanced post={post} />)}
			</GridEnhanced>
		</section>

		<section class="mp-card signal-band" data-variant="featured" aria-labelledby="signal-title" data-animate>
			<p class="mp-card__overline">Dieta de informação</p>
			<h2 class="type-h1" id="signal-title">Tech Signal Stack</h2>
			<p class="mp-card__body type-body-lg mp-text" data-measure>
				As {signalCount} fontes que acompanho para entender tecnologia, IA e política, {signalBrazilCount} delas do Brasil e da América Latina. A ordem muda a cada visita, para ninguém ficar preso nas mesmas.
			</p>
			<div class="mp-card__footer">
				<a class="mp-button" data-variant="secondary" href="/tech-signal/">
					Explorar as fontes
					<Icon icon="arrow-right" />
				</a>
			</div>
		</section>
	</main>

	<ContactCTA />
</BaseLayout>

<style>
	.home-hero {
		display: grid;
		gap: var(--space-10);
		align-items: center;
	}

	.home-hero__roles {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-hero__portrait {
		width: 100%;
		max-width: 30rem;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: top;
		border-radius: var(--photo-border-radius);
		box-shadow: var(--photo-shadow);
		filter: var(--photo-warmth);
	}

	@media (min-width: 60em) {
		.home-hero {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			gap: var(--space-16);
		}

		.home-hero__portrait {
			justify-self: end;
		}
	}

	.signal-band {
		--mp-card-bg: var(--color-bg-elevated);
		background-image: var(--gradient-subtle);
	}
</style>
