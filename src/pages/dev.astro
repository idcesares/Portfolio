---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import DevProjectCard from '../components/DevProjectCard.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { devProjects, projectCategories } from '../data/dev-projects';

const featured = devProjects.filter((project) => project.featured);
const groups = projectCategories
	.map((meta) => ({
		meta,
		projects: devProjects.filter(
			(project) => project.category === meta.id && !project.featured
		),
	}))
	.filter((group) => group.projects.length > 0);

const repositoryCount = new Set(
	devProjects.flatMap((project) => (project.repoUrl ? [project.repoUrl] : []))
).size;

const technologyFrequency = new Map<string, number>();
devProjects.forEach((project) => {
	project.techStack.forEach((technology) => {
		technologyFrequency.set(
			technology.name,
			(technologyFrequency.get(technology.name) ?? 0) + 1
		);
	});
});

const coreTechnologies = [...technologyFrequency.entries()]
	.filter(([, count]) => count > 1)
	.sort(([nameA, countA], [nameB, countB]) =>
		countB - countA || nameA.localeCompare(nameB, 'pt-BR')
	)
	.slice(0, 20)
	.map(([name]) => name);
---

<BaseLayout
	title="Projetos em código"
	description="Produtos, pesquisas aplicadas, sistemas e experimentos de Isaac D'Césares — artefatos em que educação, IA e engenharia se encontram."
>
	<main id="main-content" tabindex="-1" class="mp-container mp-section mp-stack" data-gap="16">
		<Hero
			title="Projetos em código"
			tagline="Algumas ideias viram produtos. Outras viram instrumentos de pesquisa, métodos ou protótipos. Aqui está o rastro das que chegaram ao mundo em forma de código."
			align="start"
		>
			<ul class="mp-cluster plain-list" data-gap="2" aria-label="Princípios">
				<li><Pill tone="digital"><Icon icon="book-open" /> Pesquisa aplicada</Pill></li>
				<li><Pill tone="human"><Icon icon="code" /> Código aberto</Pill></li>
				<li><Pill tone="learning"><Icon icon="pencil-line" /> Educação pelo fazer</Pill></li>
			</ul>
		</Hero>

		<nav class="mp-card project-index" data-variant="flat" aria-label="Trilhas de projetos" data-animate>
			<p class="mp-card__overline">Mapa do laboratório</p>
			<p class="type-h4">{featured.length} destaques + {devProjects.length - featured.length} projetos em {groups.length} trilhas</p>
			<ul class="mp-cluster plain-list" data-gap="2">
				{groups.map(({ meta, projects }) => (
					<li>
						<a class="mp-button" data-variant="ghost" data-size="sm" href={`#${meta.id}`}>
							{meta.title}
							<span class="mp-badge" data-tone="digital">{projects.length}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		{featured.length > 0 && (
			<section class="mp-stack" data-gap="8" aria-labelledby="featured-title" data-animate>
				<SectionHeader
					id="featured-title"
					overline="Agora em foco"
					title="Três projetos, três maneiras de construir"
					lede="Um instrumento de pesquisa auditável, um espaço colaborativo sem fricção e um sistema visual que conecta o humano ao digital."
				/>
				<div class="mp-grid featured-grid" data-gap="6">
					{featured.map((project, index) => (
						<DevProjectCard project={project} variant={index === 0 ? 'featured' : 'default'} />
					))}
				</div>
			</section>
		)}

		{groups.map(({ meta, projects }, index) => (
			<section class="mp-stack" data-gap="8" id={meta.id} aria-labelledby={`${meta.id}-title`} data-animate>
				<SectionHeader
					id={`${meta.id}-title`}
					overline={`Trilha ${(index + 1).toString().padStart(2, '0')} · ${projects.length} ${projects.length === 1 ? 'projeto' : 'projetos'}`}
					title={meta.title}
					lede={meta.description}
				/>
				<div class="mp-grid" data-min="lg" data-gap="6">
					{projects.map((project) => <DevProjectCard project={project} />)}
				</div>
			</section>
		))}

		<section class="mp-card github-section" data-variant="featured" data-tone="digital" aria-labelledby="github-title" data-animate>
			<Icon icon="github" size="xl" tone="digital" />
			<p class="mp-card__overline">Arquivo aberto</p>
			<h2 class="type-h1" id="github-title">O restante do laboratório está no GitHub</h2>
			<p class="mp-card__body mp-text" data-measure>
				Esta página é curadoria, não inventário. No GitHub ficam também notebooks, forks, testes e pequenos artefatos que não precisam disputar protagonismo, mas ajudam a mostrar como o trabalho amadurece.
			</p>
			<div class="mp-card__footer">
				<a class="mp-button" data-variant="secondary" href="https://github.com/idcesares?tab=repositories" target="_blank" rel="noopener noreferrer">
					Explorar {repositoryCount} repositórios representados
					<Icon icon="external-link" />
				</a>
			</div>
		</section>

		<section class="mp-stack" data-gap="6" aria-labelledby="tech-title" data-animate>
			<SectionHeader
				id="tech-title"
				overline="Caixa de ferramentas"
				title="A stack acompanha a pergunta"
				lede="Não coleciono frameworks: escolho o conjunto que mantém a ideia legível, testável e possível de sustentar."
			/>
			<ul class="mp-cluster plain-list" data-gap="2" aria-label="Tecnologias recorrentes nos projetos">
				{coreTechnologies.map((technology) => <li class="mp-tag">{technology}</li>)}
			</ul>
		</section>
	</main>

	<ContactCTA />
</BaseLayout>

<style>
	.plain-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-index {
		--mp-card-padding: var(--space-5);
		gap: var(--space-3);
	}

	/* Two columns; the first featured project spans the row. */
	@media (min-width: 48em) {
		.featured-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.featured-grid > :global(:first-child) {
			grid-column: 1 / -1;
		}
	}
</style>
