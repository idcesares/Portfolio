---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Você encontrou uma coisa" description="Uma pequena descoberta fora do roteiro. A curiosidade trouxe você até aqui.">
  <main id="main-content" tabindex="-1" class="mp-container mp-section meme" data-size="sm">
    <section id="invitation" aria-labelledby="secret-title">
      <p class="type-label mp-text" data-tone="digital">Arquivo confidencial · edição 1987</p>
      <h1 class="type-display" id="secret-title">Já que você<br />chegou <em>até aqui.</em></h1>
      <p class="mp-text type-body-lg" data-tone="muted">Tem uma coisa que eu precisava compartilhar com você.<br />Confia. É conteúdo de altíssimo nível.</p>
      <div class="envelope" aria-hidden="true"><span>↗</span><small>UM LINK. INFINITAS POSSIBILIDADES.</small></div>
      <a id="reveal" class="mp-button" data-size="lg" href="https://www.youtube.com/watch?v=dQw4w9WgXcQ">Pode abrir. Eu confio em você. <span aria-hidden="true">↗</span></a>
      <p class="mp-text type-small" data-tone="subtle">Última atualização: aparentemente, a internet nunca superou isso.</p>
    </section>

    <section id="surprise" hidden aria-labelledby="reveal-title">
      <p class="type-label mp-text" data-tone="digital">Experimento concluído · curiosidade confirmada</p>
      <h2 class="type-display" id="reveal-title" tabindex="-1">Você caiu.<br /><em>Com elegância.</em></h2>
      <p class="mp-text type-body-lg" data-tone="muted">Anos de evolução da internet. Inteligência artificial. Computação quântica.<br />E a gente continua clicando no link.</p>
      <div id="player" class="player"></div>
      <p class="mp-text type-small" data-tone="muted">Se o vídeo não começar, aperte o play. <a class="mp-link" href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" target="_blank" rel="noopener noreferrer">Abrir no YouTube ↗</a></p>
      <div class="mp-card certificate" data-variant="featured">
        <span class="seal" aria-hidden="true">R.</span>
        <div><p class="type-label mp-text" data-tone="human">Certificado de curiosidade excessiva</p><p>Concedido a quem viu um botão suspeito e pensou: <strong>“por que não?”</strong></p><small>Assinado: Isaac. Com uma pequena participação de Rick Astley.</small></div>
      </div>
      <div class="mp-cluster" data-justify="center" data-gap="3">
        <button id="share" class="mp-button" data-variant="secondary" type="button">Passar a curiosidade adiante ↗</button>
        <a class="mp-button" data-variant="ghost" href="/">Voltar ao portfólio, com dignidade</a>
      </div>
      <p id="share-status" class="mp-text type-small" data-tone="muted" role="status" aria-live="polite"></p>
      <div id="copy-fallback" class="mp-field" hidden><label class="mp-field__label" for="share-link">Copie este link para compartilhar:</label><input class="mp-input" id="share-link" type="url" readonly /></div>
      <p class="mp-text type-small" data-tone="subtle">Nenhuma IA foi necessária para enganar você. Só um clássico.</p>
    </section>
  </main>
</BaseLayout>

<script>
  const reveal = document.querySelector<HTMLAnchorElement>('#reveal');
  const invitation = document.querySelector<HTMLElement>('#invitation');
  const surprise = document.querySelector<HTMLElement>('#surprise');
  const player = document.querySelector<HTMLElement>('#player');

  reveal?.addEventListener('click', (event) => {
    if (!invitation || !surprise || !player || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (player.childElementCount) return;
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1&playsinline=1&rel=0';
    iframe.title = 'Rick Astley — Never Gonna Give You Up (videoclipe oficial)';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    player.append(iframe);
    invitation.hidden = true;
    surprise.hidden = false;
    document.querySelector<HTMLElement>('#reveal-title')?.focus();
  });

  document.querySelector<HTMLButtonElement>('#share')?.addEventListener('click', async () => {
    const url = new URL('/meme/', window.location.origin).href;
    const status = document.querySelector<HTMLElement>('#share-status');
    try {
      await navigator.clipboard.writeText(url);
      if (status) status.textContent = '';
      window.MembranePalette?.toast({ title: 'Link copiado', body: 'Escolha sua próxima vítima com carinho.', tone: 'success' });
    } catch {
      const fallback = document.querySelector<HTMLElement>('#copy-fallback');
      const input = document.querySelector<HTMLInputElement>('#share-link');
      if (fallback && input) {
        fallback.hidden = false;
        input.value = url;
        input.focus();
        input.select();
      }
      if (status) status.textContent = 'A cópia automática não funcionou. O link está disponível abaixo.';
    }
  });
</script>

<style>
  .meme {
    display: grid;
    text-align: center;
  }

  .meme section {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }

  .meme h1,
  .meme h2 {
    font-weight: var(--weight-medium);
  }

  .meme h1 em,
  .meme h2 em {
    color: var(--color-human-text);
  }

  /* A tilted envelope on the membrane wash: the one playful object here. */
  .envelope {
    display: grid;
    place-content: center;
    gap: var(--space-4);
    width: min(100%, 25rem);
    min-height: 12rem;
    border: var(--border-width-thin) solid var(--color-border-emphasis);
    border-radius: var(--radius-lg);
    background: var(--gradient-subtle), var(--color-bg-secondary);
    box-shadow: var(--elevation-overlay);
    rotate: -3deg;
  }

  .envelope span {
    color: var(--color-digital-text);
    font-family: var(--font-serif);
    font-size: var(--text-display);
    line-height: 1;
  }

  .envelope small {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .player {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--border-default);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-inverse);
  }

  .player :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .certificate {
    flex-direction: row;
    align-items: center;
    gap: var(--space-6);
    text-align: start;
  }

  .seal {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--space-16);
    height: var(--space-16);
    border: var(--border-width-thin) solid var(--color-action-primary);
    border-radius: var(--radius-full);
    color: var(--color-human-text);
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    font-style: italic;
    rotate: -12deg;
  }

  #copy-fallback {
    width: 100%;
    text-align: start;
  }
</style>
