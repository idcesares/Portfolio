---
export const prerender = true;

import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { AUTHOR_EMAIL, getPersonId, getSiteStructuredData } from '../utils/seo';

const email = AUTHOR_EMAIL;
const mailHref =
	'mailto:isaac.dcesares@gmail.com?subject=Contato%20pelo%20portf%C3%B3lio';

const site = Astro.site ?? new URL('https://www.dcesares.dev');
const pageUrl = new URL('/contact/', site).toString();

const socialLinks: {
	label: string;
	href: string;
	description: string;
	icon: IconName;
}[] = [
	{
		label: 'LinkedIn',
		href: 'https://linkedin.com/in/isaacdcesares',
		description: 'Para conversas profissionais, convites e parcerias institucionais.',
		icon: 'linkedin',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/idcesares',
		description: 'Para acompanhar código, projetos autorais e experimentos técnicos.',
		icon: 'github',
	},
	{
		label: 'YouTube',
		href: 'https://www.youtube.com/@idcesares/',
		description: 'Para aulas, registros, demonstrações e conteúdo em vídeo.',
		icon: 'youtube',
	},
	{
		label: 'Twitter/X',
		href: 'https://twitter.com/idcesares',
		description: 'Para notas rápidas sobre tecnologia, educação, cultura digital e nerdices em geral.',
		icon: 'twitter',
	},
];

const conversationTypes: {
	title: string;
	description: string;
	icon: IconName;
	tone: 'human' | 'digital' | 'success' | 'warning';
}[] = [
	{
		title: 'Palestras e eventos',
		description: 'IA na educação, cultura maker, letramento digital e transformação institucional.',
		icon: 'mic',
		tone: 'human',
	},
	{
		title: 'Projetos e consultoria',
		description: 'Estratégia, protótipos, desenho de experiências e tecnologia educacional aplicada.',
		icon: 'lightbulb',
		tone: 'digital',
	},
	{
		title: 'Pesquisa e colaboração',
		description: 'Universidades, grupos de estudo, publicações e investigações em computação e educação.',
		icon: 'book-open',
		tone: 'success',
	},
	{
		title: 'Tecnologia e código',
		description: 'Produtos digitais, automações, IA aplicada, sistemas web e experimentos autorais.',
		icon: 'code',
		tone: 'warning',
	},
];

const messageGuide = [
	'Contexto do projeto, convite ou pergunta.',
	'Prazo, cidade, formato ou janela desejada.',
	'Link, briefing, referência ou material de apoio, se existir.',
];

const structuredData = [
	...getSiteStructuredData(site),
	{
		'@context': 'https://schema.org',
		'@type': 'ContactPage',
		name: "Contato | Isaac D'Césares",
		url: pageUrl,
		description:
			'Página de contato para projetos, palestras, pesquisa e parcerias com Isaac D\'Césares.',
		mainEntity: {
			'@id': getPersonId(site),
			contactPoint: {
				'@type': 'ContactPoint',
				email,
				contactType: 'professional inquiries',
				availableLanguage: ['pt-BR', 'en'],
			},
		},
	},
];
---

<BaseLayout
	title="Contato"
	description="Fale com Isaac D'Césares sobre tecnologia educacional, IA aplicada, palestras, pesquisa, projetos e colaborações."
	image="/assets/portrait.webp"
	imageAlt="Retrato de Isaac D'Césares"
	structuredData={structuredData}
>
	<main id="main-content" tabindex="-1" class="mp-container mp-stack contact-page" data-gap="16">
		<section class="mp-section contact-hero" data-size="sm" aria-labelledby="contact-title">
			<div class="hero-copy mp-stack" data-gap="5">
				<p class="type-label mp-text" data-tone="human">Contato</p>
				<h1 class="type-display" id="contact-title">Vamos abrir uma boa conversa.</h1>
				<p class="mp-text type-body-lg" data-tone="muted" data-measure>
					Projetos de tecnologia educacional, IA aplicada, pesquisa, palestras e experiências
					digitais que precisam ficar de pé no mundo real.
				</p>
				<div class="hero-actions mp-cluster" data-gap="3">
					<a class="mp-button" data-size="lg" href={mailHref}>
						Enviar email
						<Icon icon="send" />
					</a>
					<a class="mp-button" data-variant="ghost" data-size="lg" href="#canais">Ver canais</a>
				</div>
			</div>

			<figure class="contact-hero__visual">
				<Image
					src={portrait}
					alt="Retrato de Isaac D'Césares"
					width={960}
					height={1200}
					quality={80}
					sizes="(min-width: 800px) 40vw, calc(100vw - 48px)"
					loading="eager"
					decoding="async"
				/>
				<figcaption class="mp-card contact-hero__registers">
					<span class="mp-tag" data-tone="human">Humano</span>
					<span class="type-small">educação, pesquisa, presença</span>
					<span class="mp-tag" data-tone="digital">Digital</span>
					<span class="type-small">IA, código, sistemas</span>
				</figcaption>
			</figure>
		</section>

		<section class="mp-card contact-direct" data-variant="featured" data-tone="digital" aria-labelledby="direct-title" data-animate>
			<p class="mp-card__overline">Canal principal</p>
			<h2 class="type-h2" id="direct-title">Email direto, contexto claro, conversa sem ruído.</h2>
			<p class="mp-card__body">
				<a class="mp-link contact-direct__email" href={mailHref}>{email}</a>
			</p>
			<p class="mp-card__body">Respondo melhor quando a mensagem já traz intenção, prazo e um pouco do contexto.</p>
		</section>

		<section class="mp-stack" data-gap="8" aria-labelledby="conversation-title">
			<header class="mp-stack" data-gap="2" data-animate>
				<p class="type-label mp-text" data-tone="human">Bons motivos para chamar</p>
				<h2 class="type-h1" id="conversation-title">Se a pauta cruza educação, tecnologia e impacto, provavelmente cabe aqui.</h2>
			</header>
			<div class="mp-grid" data-min="sm" data-gap="6" data-animate-stagger>
				{
					conversationTypes.map(({ title, description, icon, tone }) => (
						<article class="mp-card conversation-item" data-animate>
							<Icon icon={icon} size="lg" tone={tone} />
							<h3 class="mp-card__title">{title}</h3>
							<p class="mp-card__body">{description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="contact-message" aria-labelledby="message-title" data-animate>
			<div class="mp-stack" data-gap="2">
				<p class="type-label mp-text" data-tone="subtle">Para acelerar a resposta</p>
				<h2 class="type-h1" id="message-title">Uma boa primeira mensagem já desenha o começo do trabalho.</h2>
			</div>
			<ol class="mp-steps" aria-label="O que incluir na mensagem">
				{
					messageGuide.map((item) => (
						<li class="mp-steps__item">
							<p class="mp-steps__label">{item}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section id="canais" class="mp-stack" data-gap="8" aria-labelledby="channels-title">
			<header class="mp-stack" data-gap="2" data-animate>
				<p class="type-label mp-text" data-tone="digital">Outros lugares</p>
				<h2 class="type-h1" id="channels-title">Cada canal tem uma função. Escolha o caminho mais natural.</h2>
			</header>
			<ul class="mp-grid channel-grid" data-min="sm" data-gap="6" data-animate-stagger>
				{
					socialLinks.map(({ label, href, description, icon }) => (
						<li class="mp-card" data-tone="digital" data-animate>
							<Icon icon={icon} size="lg" tone="digital" />
							<h3 class="mp-card__title">
								<a class="mp-card__link" href={href} target="_blank" rel="noreferrer">{label}</a>
							</h3>
							<p class="mp-card__body">{description}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mp-card final-cta" data-variant="featured" aria-labelledby="final-title" data-animate>
			<p class="mp-card__overline">Próximo passo</p>
			<h2 class="type-display" id="final-title">Vamos cocriar?</h2>
			<p class="mp-card__body type-body-lg mp-text" data-measure>
				Se a conversa ainda está meio aberta, tudo bem. Comece pelo essencial e a gente desenha o resto junto.
			</p>
			<div class="mp-card__footer">
				<a class="mp-button" data-size="lg" href={mailHref}>
					Enviar email
					<Icon icon="send" />
				</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.contact-hero {
		display: grid;
		gap: var(--space-10);
		align-items: center;
	}

	.contact-hero__visual {
		display: grid;
		gap: var(--space-4);
		margin: 0;
	}

	.contact-hero__visual img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: top;
		border-radius: var(--photo-border-radius);
		box-shadow: var(--photo-shadow);
		filter: var(--photo-warmth);
	}

	.contact-hero__registers {
		--mp-card-padding: var(--space-4);
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		color: var(--color-text-secondary);
	}

	.contact-direct__email {
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		overflow-wrap: anywhere;
	}

	.contact-message {
		display: grid;
		gap: var(--space-8);
	}

	.channel-grid {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 60em) {
		.contact-hero {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			gap: var(--space-16);
		}

		.contact-message {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: start;
		}
	}
</style>
