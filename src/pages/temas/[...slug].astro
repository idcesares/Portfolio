---
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import ContentPreview from '../../components/ContentPreview.astro';
import GridEnhanced from '../../components/GridEnhanced.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { devProjects } from '../../data/dev-projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveImageSrc } from '../../utils/seo';

interface Props {
	theme: CollectionEntry<'themes'>;
}

export const prerender = true;

export async function getStaticPaths() {
	const themes = await getCollection('themes');
	return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

const { theme } = Astro.props;
const { title, description, work, project: projectId } = theme.data;
const entries = (await getEntries(work)).filter((entry) => entry && !entry.data.draft);
const project = devProjects.find(({ id }) => id === projectId);
if (!project?.demoUrl) {
	throw new Error(`Theme ${theme.id} needs a published project URL for ${projectId}.`);
}
const cover = entries.find(({ data }) => typeof data.img !== 'string')?.data;
---

<BaseLayout title={title} description={description} image={cover && resolveImageSrc(cover.img)} imageAlt={cover?.img_alt}>
	<main id="main-content" tabindex="-1" class="mp-container mp-section mp-stack" data-gap="12">
		<Hero title={title} tagline={description} align="start" />

		{entries.length > 0 && (
			<section class="mp-stack" data-gap="5" aria-labelledby="theme-work-title">
				<SectionHeader id="theme-work-title" title="Leituras e experiências" />
				<GridEnhanced>
					{entries.map((entry) => <ContentPreview entry={entry} />)}
				</GridEnhanced>
			</section>
		)}

		<section class="mp-card" data-variant="featured" data-tone="digital" aria-labelledby="theme-project-title">
			<h2 class="type-h3 theme-project-title" id="theme-project-title">{project.title}</h2>
			<p class="mp-card__body mp-text" data-measure>{project.description}</p>
			<div class="mp-card__footer mp-cluster" data-gap="4">
				<a class="mp-button" href={project.demoUrl}>
					Visitar o site <Icon icon="external-link" />
				</a>
				<a class="mp-link" href={`/dev/#project-${project.id}`}>Ver o projeto em código</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.theme-project-title {
		overflow-wrap: anywhere;
	}
</style>
