---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GridEnhanced from '../components/GridEnhanced.astro';

const deals = [
  {
    title: 'Perplexity Pro',
    description: 'Meu buscador com IA do dia a dia. Use o código de indicação "HEUYI5O6" no cadastro pra ganhar um mês Pro grátis.',
    link: 'https://www.perplexity.ai/pro?referral_code=HEUYI5O6',
  },
  {
    title: 'Beacons',
    description: 'Ferramenta simples pra montar página de links personalizada. Usando o código "idcesares" você libera recursos pagos por um tempo.',
    link: 'https://beacons.ai/signup?c=idcesares',
  },
{
    title: 'You.com',
    description: 'Interface de chat com acesso a vários modelos de IA num lugar só. O link de indicação te dá um período estendido pra testar.',
    link: 'https://you.com/join/XWF8WJ5T',
},
{
    title: 'Lovable',
    description: 'Plataforma pra gerar apps funcionais por prompt. Meu convite abre acesso à fila prioritária.',
    link: 'https://lovable.dev/invite/13eee9bc-6d52-46de-b6af-8f12534a7a42',
}];

---
<BaseLayout title="Indico e uso" description="Ferramentas digitais que uso e recomendo, com cupons e links de indicação quando disponíveis.">
	<main id="main-content" tabindex="-1" class="mp-container mp-section mp-stack" data-gap="10">
		<Hero
			title="Indico e uso"
			tagline="Ferramentas que eu uso no dia a dia. Alguns links dão desconto ou benefício, outros são só registro do que funciona."
			align="start"
		/>
		<GridEnhanced variant="compact">
			{
				deals.map((deal) => (
					<li class="mp-card" data-tone="digital" data-animate>
						<h2 class="mp-card__title">
							<a class="mp-card__link" href={deal.link} target="_blank" rel="noopener noreferrer">{deal.title}</a>
						</h2>
						<p class="mp-card__body">{deal.description}</p>
						<div class="mp-card__footer">
							<span class="mp-link" data-variant="standalone" aria-hidden="true">Abrir link</span>
						</div>
					</li>
				))
			}
		</GridEnhanced>
	</main>
</BaseLayout>
