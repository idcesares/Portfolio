---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

import { render } from 'astro:content';
import { getBreadcrumbStructuredData, getFaqStructuredData, getWorkStructuredData } from '../../utils/seo';

interface Props {
	entry: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getCollection('work', ({ data }) => !data.draft);
	return work.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

export const prerender = true;

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);

const site = Astro.site ?? new URL('https://www.dcesares.dev');
const structuredData = [
	getWorkStructuredData(entry, site),
	getBreadcrumbStructuredData(site, [
		{ name: 'Início', path: '/' },
		{ name: 'Trabalhos', path: '/work/' },
		{ name: entry.data.title, path: `/work/${entry.id}/` },
	]),
	...(entry.data.faq?.length ? [getFaqStructuredData(entry.data.faq)] : []),
];
---

<ArticleLayout entry={entry} minutesRead={remarkPluginFrontmatter.minutesRead} structuredData={structuredData}>
	<Content />
</ArticleLayout>
