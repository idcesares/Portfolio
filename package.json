{
  "name": "dcesares.dev",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:preview": "node scripts/node-preview.mjs build",
    "preview": "node scripts/node-preview.mjs preview",
    "astro": "astro",
    "check": "astro check && node scripts/check-assets.mjs && node scripts/check-membrane.mjs && pnpm test:unit && astro build",
    "check:assets": "node scripts/check-assets.mjs",
    "check:membrane": "node scripts/check-membrane.mjs",
    "check:feeds": "node scripts/check-feeds.mjs",
    "sync:membrane": "node scripts/sync-membrane.mjs",
    "test:browser": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "audit": "pnpm audit --audit-level high",
    "audit:full": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/node": "11.1.11",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@lucide/astro": "^1.71.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.8",
    "astro-embed": "^0.14.0",
    "astro-seo": "^1.2.0",
    "fuse.js": "^7.5.0",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.6",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "ajv": "^8.17.1",
      "lodash": "^4.17.23",
      "glob": ">=14.0.2",
      "minimatch": ">=11.0.1",
      "tar": ">=7.5.11",
      "yaml": "^2.9.0",
      "undici": ">=8.12.2",
      "@emnapi/runtime": "1.11.3",
      "@emnapi/core": "1.11.3",
      "fast-uri": ">=3.1.9 <4",
      "@vercel/cli-config>zod": ">=4.6.6",
      "@astrojs/rss>zod": ">=4.6.6",
      "@astrojs/sitemap>zod": ">=4.6.6"
    }
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "typescript": "~6.0.3"
  }
